---
const brandDescription =
	"Simple tools for important dates, focus, and daily rhythm.";

const currentLocale = "English";
---

<!-- Footer｜全站頁尾 -->

<!-- Footer｜桌機版頁尾 -->
<footer class="hidden border-t border-white/20 md:block">
	<div class="mx-auto flex max-w-5xl items-start justify-between gap-6 px-6 py-5">
		<!-- Footer｜品牌區 -->
		<div class="max-w-sm">
			<a href="/">
				<img
					src="/brand/logo-white.svg"
					alt="Timiva"
					class="h-6 w-auto"
					width="76"
					height="28"
				/>
			</a>
			<p class="mt-2 text-sm leading-snug text-slate-400">
				{brandDescription}
			</p>
		</div>

		<!-- Footer｜導覽連結 -->
		<nav aria-label="Footer navigation" class="text-sm">
			<div class="flex flex-col items-end gap-2">
				<div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-1">
					<a
						href="/en/tools/"
						class="text-slate-300 transition-colors hover:text-white"
					>
						All Tools
					</a>
					<a
						href="/en/privacy/"
						class="text-slate-300 transition-colors hover:text-white"
					>
						Privacy Policy
					</a>
					<a
						href="/en/terms/"
						class="text-slate-300 transition-colors hover:text-white"
					>
						Terms of Use
					</a>
					<a
						href="/en/contact/"
						class="text-slate-300 transition-colors hover:text-white"
					>
						Contact
					</a>
					<!-- Footer｜語言切換 -->
					<details class="group relative">
						<summary
							class="inline-flex cursor-pointer list-none items-center gap-1.5 text-slate-400 transition-colors hover:text-white [&::-webkit-details-marker]:hidden"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 16 16"
								fill="none"
								class="h-4 w-4 shrink-0"
								aria-hidden="true"
							>
								<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"
								></circle>
								<path
									d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path>
							</svg>
							<span>{currentLocale}</span>
						</summary>
						<div
							class="absolute bottom-full right-0 z-10 mb-2 min-w-32 rounded-xl border border-white/20 bg-slate-950/95 py-1 backdrop-blur-sm"
						>
							<a
								href="/en/"
								class="block px-3 py-2 text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
							>
								English
							</a>
							<a
								href="/zh/"
								class="block px-3 py-2 text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
							>
								中文
							</a>
						</div>
					</details>
				</div>
				<div class="text-slate-400">
					<span>© 2026 Timiva</span>
				</div>
			</div>
		</nav>
	</div>
</footer>

<!-- Footer｜手機版頁尾 -->
<footer class="block border-t border-white/20 md:hidden">
	<!-- Footer｜第一段：Timiva / 全部工具 -->
	<div class="flex items-center justify-between gap-4 px-4 py-3">
		<a href="/">
			<img
				src="/brand/logo-white.svg"
				alt="Timiva"
				class="h-6 w-auto"
				width="76"
				height="28"
			/>
		</a>
		<a
			href="/en/tools/"
			class="inline-flex min-h-11 items-center gap-1.5 text-sm text-slate-300 transition-colors hover:text-white"
		>
			全部工具
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 16 16"
				fill="none"
				class="h-4 w-4 shrink-0"
				aria-hidden="true"
			>
				<path
					d="M3 8h8M9 5l3 3-3 3"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>

	<div class="border-t border-white/20"></div>

	<!-- Footer｜第二段：導覽連結 / 語言切換 / 版權 -->
	<div class="px-4 py-3">
		<!-- Footer｜導覽連結 -->
		<nav aria-label="Footer navigation">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
				<a
					href="/en/privacy/"
					class="inline-flex min-h-11 items-center text-slate-300 transition-colors hover:text-white"
				>
					隱私權政策
				</a>
				<a
					href="/en/terms/"
					class="inline-flex min-h-11 items-center text-slate-300 transition-colors hover:text-white"
				>
					使用政策
				</a>
				<a
					href="/en/contact/"
					class="inline-flex min-h-11 items-center text-slate-300 transition-colors hover:text-white"
				>
					聯絡我們
				</a>
				<!-- Footer｜語言切換 -->
				<details class="group relative">
					<summary
						class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-slate-400 transition-colors hover:text-white [&::-webkit-details-marker]:hidden"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 16 16"
							fill="none"
							class="h-4 w-4 shrink-0"
							aria-hidden="true"
						>
							<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"
							></circle>
							<path
								d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"></path>
						</svg>
						<span>{currentLocale}</span>
					</summary>
					<div
						class="absolute bottom-full left-0 z-10 mb-2 min-w-32 rounded-xl border border-white/20 bg-slate-950/95 py-1 backdrop-blur-sm"
					>
						<a
							href="/en/"
							class="block px-3 py-2 text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
						>
							English
						</a>
						<a
							href="/zh/"
							class="block px-3 py-2 text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
						>
							中文
						</a>
					</div>
				</details>
			</div>

			<p class="mt-2 text-sm text-slate-500">© 2026 Timiva</p>
		</nav>
	</div>
</footer>
