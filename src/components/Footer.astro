---
import {
	getAlternatePaths,
	getLocalizedPath,
	routePaths,
	type Locale,
} from "../i18n/config";
import { getMessages } from "../i18n/messages";

interface Props {
	locale?: Locale;
	analyticsEnabled?: boolean;
}

const { locale = "en", analyticsEnabled = false } = Astro.props;
const messages = getMessages(locale);
const footer = messages.footer;
const nav = messages.nav;

const homeHref = getLocalizedPath(locale, routePaths.home);
const toolsHref = getLocalizedPath(locale, routePaths.allTools);
const privacyHref = getLocalizedPath(locale, routePaths.privacy);
const termsHref = getLocalizedPath(locale, routePaths.terms);
const contactHref = getLocalizedPath(locale, routePaths.contact);

const pathname = Astro.url.pathname;
const isLocalizedPath =
	pathname === "/zh/" ||
	pathname.startsWith("/zh/") ||
	pathname === "/en/" ||
	pathname.startsWith("/en/");
const alternatePaths = isLocalizedPath ? getAlternatePaths(pathname) : null;
const enHref = alternatePaths?.en ?? getLocalizedPath("en", routePaths.home);
const zhHref = alternatePaths?.zh ?? getLocalizedPath("zh", routePaths.home);
const currentLocaleLabel = locale === "zh" ? nav.chinese : nav.english;
---

<!-- Footer｜全站頁尾 -->

<!-- Footer｜桌機版頁尾 -->
<footer class="hidden border-t border-white/20 md:block">
	<div class="mx-auto flex max-w-5xl items-start justify-between gap-6 px-6 py-5">
		<!-- Footer｜品牌區 -->
		<div class="max-w-sm">
			<a href={homeHref}>
				<img
					src="/brand/logo-white.svg"
					alt="Timiva"
					class="h-6 w-auto"
					width="76"
					height="28"
				/>
			</a>
			<p class="mt-2 text-sm leading-snug text-slate-400">
				{footer.tagline}
			</p>
		</div>

		<!-- Footer｜導覽連結 -->
		<nav aria-label="Footer navigation" class="text-sm">
			<div class="flex flex-col items-end gap-2">
				<div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-1">
					<a
						href={toolsHref}
						class="text-slate-300 transition-colors hover:text-white"
					>
						{footer.allTools}
					</a>
					<a
						href={privacyHref}
						class="text-slate-300 transition-colors hover:text-white"
					>
						{footer.privacy}
					</a>
					<a
						href={termsHref}
						class="text-slate-300 transition-colors hover:text-white"
					>
						{footer.terms}
					</a>
					<a
						href={contactHref}
						class="text-slate-300 transition-colors hover:text-white"
					>
						{footer.contact}
					</a>
					{
						analyticsEnabled && (
							<button
								type="button"
								data-footer-analytics-settings
								class="text-slate-300 transition-colors hover:text-white"
							>
								{footer.analyticsSettings}
							</button>
						)
					}
					<!-- Footer｜語言切換 -->
					<details class="group relative">
						<summary
							class="inline-flex list-none items-center gap-1.5 text-slate-400 transition-colors hover:text-white [&::-webkit-details-marker]:hidden"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 16 16"
								fill="none"
								class="h-4 w-4 shrink-0"
								aria-hidden="true"
							>
								<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"
								></circle>
								<path
									d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path>
							</svg>
							<span>{currentLocaleLabel}</span>
						</summary>
						<div
							class="absolute bottom-full right-0 z-10 mb-2 min-w-32 rounded-xl border border-white/20 bg-slate-950/95 py-1 backdrop-blur-sm"
						>
							<a
								href={enHref}
								class="block px-3 py-2 text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
							>
								{nav.english}
							</a>
							<a
								href={zhHref}
								class="block px-3 py-2 text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
							>
								{nav.chinese}
							</a>
						</div>
					</details>
				</div>
				<div class="text-slate-400">
					<span>{footer.copyright}</span>
				</div>
			</div>
		</nav>
	</div>
</footer>

<!-- Footer｜手機版頁尾 -->
<footer class="block border-t border-white/20 md:hidden">
	<!-- Footer｜第一段：Timiva / 全部工具 -->
	<div class="flex items-center justify-between gap-4 px-4 py-3">
		<a href={homeHref}>
			<img
				src="/brand/logo-white.svg"
				alt="Timiva"
				class="h-6 w-auto"
				width="76"
				height="28"
			/>
		</a>
		<a
			href={toolsHref}
			class="inline-flex min-h-11 items-center gap-1.5 text-sm text-slate-300 transition-colors hover:text-white"
		>
			{footer.allTools}
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 16 16"
				fill="none"
				class="h-4 w-4 shrink-0"
				aria-hidden="true"
			>
				<path
					d="M3 8h8M9 5l3 3-3 3"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>

	<div class="border-t border-white/20"></div>

	<!-- Footer｜第二段：導覽連結 / 語言切換 / 版權 -->
	<div class="px-4 py-3">
		<!-- Footer｜導覽連結 -->
		<nav aria-label="Footer navigation">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
				<a
					href={privacyHref}
					class="inline-flex min-h-11 items-center text-slate-300 transition-colors hover:text-white"
				>
					{footer.privacy}
				</a>
				<a
					href={termsHref}
					class="inline-flex min-h-11 items-center text-slate-300 transition-colors hover:text-white"
				>
					{footer.terms}
				</a>
				<a
					href={contactHref}
					class="inline-flex min-h-11 items-center text-slate-300 transition-colors hover:text-white"
				>
					{footer.contact}
				</a>
				{
					analyticsEnabled && (
						<button
							type="button"
							data-footer-analytics-settings
							class="inline-flex min-h-11 items-center text-slate-300 transition-colors hover:text-white"
						>
							{footer.analyticsSettings}
						</button>
					)
				}
				<!-- Footer｜語言切換 -->
				<details class="group relative">
					<summary
						class="inline-flex min-h-11 list-none items-center gap-1.5 text-slate-400 transition-colors hover:text-white [&::-webkit-details-marker]:hidden"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 16 16"
							fill="none"
							class="h-4 w-4 shrink-0"
							aria-hidden="true"
						>
							<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"
							></circle>
							<path
								d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"></path>
						</svg>
						<span>{currentLocaleLabel}</span>
					</summary>
					<div
						class="absolute bottom-full left-0 z-10 mb-2 min-w-32 rounded-xl border border-white/20 bg-slate-950/95 py-1 backdrop-blur-sm"
					>
						<a
							href={enHref}
							class="block px-3 py-2 text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
						>
							{nav.english}
						</a>
						<a
							href={zhHref}
							class="block px-3 py-2 text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
						>
							{nav.chinese}
						</a>
					</div>
				</details>
			</div>

			<p class="mt-2 text-sm text-slate-500">{footer.copyright}</p>
		</nav>
	</div>
</footer>
