---
import InnerPageShell from "./InnerPageShell.astro";
import type { Locale } from "../i18n/config";

interface Props {
	locale: Locale;
	heading: string;
	metaLine?: string;
}

const { locale, heading, metaLine } = Astro.props;
void locale;
---

<InnerPageShell>
	<section>
		<div class="text-left md:text-center">
			<div class="space-y-4">
				<h1 class="text-3xl font-semibold tracking-normal md:text-4xl">{heading}</h1>
				{
					metaLine && (
						<p class="mx-auto max-w-xl text-sm leading-relaxed text-slate-500 md:text-base">
							{metaLine}
						</p>
					)
				}
			</div>
		</div>
	</section>
	<section>
		<div
			class="legal-markdown mx-auto max-w-3xl text-left text-base leading-relaxed text-slate-300 [&_a]:underline [&_a]:decoration-white/20 [&_a]:underline-offset-4 [&_a]:transition-colors [&_a:hover]:text-white [&_a:hover]:decoration-white/40 [&_h2]:mb-4 [&_h2]:mt-12 [&_h2]:font-semibold [&_h2]:text-slate-100 [&_h2]:text-xl [&_li:last-child]:mb-4 [&_li]:ml-5 [&_li]:list-disc [&_p]:mb-4 [&_p]:text-slate-300 [&_ul]:space-y-2"
		>
			<slot />
		</div>
	</section>
</InnerPageShell>
