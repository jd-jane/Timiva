---
/**
 * Taiwan Annual Leave Calculator V2 — ToolPageFrame adopter.
 * B0–B2B Desktop · B2C Mobile AME（capsule → live YMD／leave／Reset）.
 */
import RelatedToolRow from "../../RelatedToolRow.astro";
import ResultSummary from "../shared/ResultSummary.astro";
import ToolPageFrame from "../shared/ToolPageFrame.astro";
import DesktopCalendar from "../shared/DesktopCalendar.astro";
import AdaptiveMobileEditor from "../shared/AdaptiveMobileEditor.astro";
import AmeFieldError from "../shared/AmeFieldError.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import { getCatalogTool, type CatalogToolId } from "../../../data/toolsCatalog";
import "../../../styles/tools/taiwan-annual-leave-calculator-v2.css";
import "../../../styles/tools/adaptive-mobile-editor.css";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.taiwanAnnualLeaveCalculator;
const faqSchema = buildFaqPageJsonLd(m.faq.items);
const mathLocale = locale === "zh" ? "zh" : "en";
const intlLocale = locale === "zh" ? "zh-TW" : "en-US";

/** Catalog-declared outbound only — no getRelatedTools featured padding. */
const talcCatalog = getCatalogTool("taiwan-annual-leave-calculator");
const declaredRelatedIds = (talcCatalog?.relatedIds ?? []) as CatalogToolId[];

const toolCopy: Record<
	CatalogToolId,
	{ title: string; relatedDescription: string }
> = {
	"event-countdown": messages.tools.eventCountdown,
	"date-range": messages.tools.dateRange,
	"countdown-timer": messages.tools.countdownTimer,
	"year-progress": messages.tools.yearProgress,
	"age-calculator": messages.tools.ageCalculator,
	"days-between-dates": messages.tools.daysBetweenDates,
	"business-days-calculator": messages.tools.businessDaysCalculator,
	"life-progress": messages.tools.lifeProgress,
	"date-calculator": messages.tools.dateCalculator,
	"hours-calculator": messages.tools.hoursCalculator,
	"japanese-era-converter": messages.tools.japaneseEraConverter,
	"lunar-date-converter": messages.tools.lunarDateConverter,
	"taiwan-annual-leave-calculator": messages.tools.taiwanAnnualLeaveCalculator,
};

const relatedToolItems = declaredRelatedIds
	.map((id) => getCatalogTool(id))
	.filter((tool): tool is NonNullable<typeof tool> => Boolean(tool?.available))
	.map((tool) => ({
		href: getLocalizedPath(locale, `/${tool.slug}/`),
		name: toolCopy[tool.id].title,
		description: toolCopy[tool.id].relatedDescription,
		icon: catalogIconMap[tool.id],
	}));

const rsPrimary = {
	text: m.resultPlaceholder,
	ariaLabel: m.resultAriaLabel,
};

const clientI18n = {
	locale: mathLocale,
	intlLocale,
	resultPlaceholder: m.resultPlaceholder,
	resultAriaLabel: m.resultAriaLabel,
	definitionAnniversary: m.definitionAnniversary,
	resultInitialSupport: m.resultInitialSupport,
	calendarYearTip: m.calendarYearTip,
	formulaHeading: m.formulaHeading,
	infoAriaLabel: m.infoAriaLabel,
	invalidHireDate: m.invalidHireDate,
	openCalendarAriaLabel: m.openCalendarAriaLabel,
	capsulePlaceholder: m.capsulePlaceholder,
	calendarLabel: m.calendarLabel,
	previousMonth: m.previousMonth,
	nextMonth: m.nextMonth,
	monthFieldLabel: m.monthFieldLabel,
	yearFieldLabel: m.yearFieldLabel,
	weekdays: m.weekdays,
	supportHireTenure: m.supportHireTenure,
	supportNextStage: m.supportNextStage,
	supportNextStageCalendarYear: m.supportNextStageCalendarYear,
	supportMaxReached: m.supportMaxReached,
};
---

<div
	data-taiwan-annual-leave-calculator-v2
	data-talc-locale={mathLocale}
	data-talc-phase="b2c-mobile"
	data-talc-client-i18n={JSON.stringify(clientI18n)}
>
	<ToolPageFrame
		locale={locale}
		relatedDrawerAriaLabel={m.relatedToolsDrawerAriaLabel}
		toggleRelatedDrawerAriaLabel={m.toggleRelatedToolsDrawerAriaLabel}
		relatedHeading={m.relatedToolsHeading}
		mobileControlsAriaLabel={m.mobileControlsAriaLabel}
	>
		{/* 第一屏 H1：不放 short description */}
		<Fragment slot="title">{m.kicker}</Fragment>

		<div slot="result" class="talc-result-host">
			{/*
			  ResultSummary：主結果 primary（SSR = ?；live 由 script 用 primaryDisplay）。
			  主結果字級：blocking inline 對齊 DBD「0」。
			*/}
			<style is:inline>
				[data-taiwan-annual-leave-calculator-v2]
					[data-result-summary][data-rs-content="textual"],
				[data-taiwan-annual-leave-calculator-v2]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
				[data-taiwan-annual-leave-calculator-v2]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
					--rs-textual-primary-size: clamp(7.5rem, 38vw, 10.5rem);
				}
				@media (min-width: 768px) {
					[data-taiwan-annual-leave-calculator-v2]
						[data-result-summary][data-rs-content="textual"],
					[data-taiwan-annual-leave-calculator-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
					[data-taiwan-annual-leave-calculator-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: 13rem;
					}
				}
				@media (orientation: landscape) and (max-height: 700px) and (max-width: 1200px) and (hover: none) {
					[data-taiwan-annual-leave-calculator-v2]
						[data-result-summary][data-rs-content="textual"],
					[data-taiwan-annual-leave-calculator-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
					[data-taiwan-annual-leave-calculator-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"],
					[data-taiwan-annual-leave-calculator-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"] {
						--rs-textual-primary-size: 3.75rem;
					}
				}
			</style>
			<ResultSummary
				content="textual"
				layout="desktop"
				variant="spacious"
				ariaLabel={m.resultsLabel}
				primary={rsPrimary}
				weekday={null}
				support={null}
				class="talc-result-summary"
			/>

			{/*
			  第二層定義：週年／曆年統一「特休天數」。
			  ⓘ 展開區在定義下方、divider 上方。
			*/}
			<div class="talc-definition-row" data-talc-definition-row>
				<p class="talc-definition" data-talc-definition>{m.definitionAnniversary}</p>
				<button
					type="button"
					class="talc-info"
					data-talc-info
					hidden
					disabled
					aria-expanded="false"
					aria-controls="talc-info-panel"
					aria-label={m.infoAriaLabel}
				>
					i
				</button>
			</div>

			<div
				class="talc-info-panel"
				id="talc-info-panel"
				data-talc-info-panel
				aria-hidden="true"
				inert
			>
				<div class="talc-info-panel__inner">
					<div class="talc-formula" data-talc-formula>
						<p class="talc-formula__heading">{m.formulaHeading}</p>
						<ul class="talc-formula__lines" data-talc-formula-lines></ul>
						<p class="talc-tip" data-talc-tip>{m.calendarYearTip}</p>
					</div>
				</div>
			</div>

			<div
				class="talc-result-meta tool-textual-result-support-divider"
				data-talc-meta
			>
				<p class="talc-support" data-talc-support>
					<span class="talc-support__line" data-talc-support-line="1"
						>{m.resultInitialSupport}</span
					>
					<span class="talc-support__join" aria-hidden="true"> / </span>
					<span class="talc-support__line" data-talc-support-line="2" hidden></span>
				</p>
			</div>
		</div>

		{/* Desktop：Smart Date + leave system + Reset */}
		<div
			slot="desktopControls"
			class="talc-desktop-cluster tool-standard-pill-field-cluster"
			aria-label={m.upperControlsAriaLabel}
		>
			<div class="talc-date-pill tool-standard-pill-field" data-talc-date-pill>
				<input
					type="text"
					class="talc-date-value"
					data-talc-date-value
					value=""
					placeholder={m.hireDatePlaceholder}
					aria-label={m.hireDateLabel}
					inputmode="numeric"
					autocomplete="off"
					spellcheck="false"
				/>
				<span
					class="talc-date-invalid-icon"
					data-talc-date-invalid
					hidden
					aria-label={m.invalidHireDate}
				>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
						<path
							fill="#0f172a"
							d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
						></path>
					</svg>
				</span>
				<button
					type="button"
					class="talc-calendar-icon"
					data-talc-calendar-toggle
					aria-expanded="false"
					aria-controls="talc-calendar-popover"
					aria-label={m.openCalendarAriaLabel}
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<rect x="3" y="5" width="18" height="16" rx="3"></rect>
						<path d="M8 3v4M16 3v4M7 11h10" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>

			<div
				class="talc-leave-system"
				role="group"
				aria-label={m.leaveSystemGroupAriaLabel}
			>
				<button
					type="button"
					class="talc-leave-option is-active"
					data-talc-leave="anniversary"
					aria-pressed="true"
				>
					{m.anniversaryLabel}
				</button>
				<button
					type="button"
					class="talc-leave-option"
					data-talc-leave="calendar-year"
					aria-pressed="false"
				>
					{m.calendarYearLabel}
				</button>
			</div>

			<button type="button" class="tool-text-action--muted talc-reset" data-talc-reset>
				{m.resetLabel}
			</button>
		</div>

		<button
			slot="mobilePrimaryControl"
			type="button"
			class="preview-tool-control-btn tool-primary-entry-capsule tool-utility-control talc-mobile-capsule"
			data-talc-capsule
			aria-label={m.openSheetAriaLabel}
		>
			<span data-talc-capsule-label>{m.capsulePlaceholder}</span>
		</button>

		<AdaptiveMobileEditor
			slot="ame"
			id="talc-ame"
			ariaLabel={m.sheetAriaLabel}
			title={m.sheetTitle}
		>
			<div
				slot="content"
				class="talc-ame-form"
				data-talc-ame-form
				data-talc-ymd-year-ph={m.yearPlaceholder}
				data-talc-ymd-month-ph={m.monthPlaceholder}
				data-talc-ymd-day-ph={m.dayPlaceholder}
			>
				{/*
				  Canonical mobile YMD：三格橫向並排；
				  每格＝persistent label｜value／placeholder（Age visual role；AME button＋Numeric Keypad）。
				*/}
				<div
					class="talc-ame-ymd"
					data-talc-ame-ymd
					role="group"
					aria-label={m.hireDateLabel}
				>
					<button
						type="button"
						class="talc-ame-field"
						data-ame-numeric-field="year"
						data-ame-active="false"
						aria-label={m.ameYearLabel}
						aria-describedby="ame-field-error-year"
					>
						<span class="talc-ame-field-label">{m.ameYearLabel}</span>
						<span class="talc-ame-field-value is-placeholder" data-talc-segment-value>
							{m.yearPlaceholder}
						</span>
						<AmeFieldError fieldId="year" />
					</button>
					<button
						type="button"
						class="talc-ame-field"
						data-ame-numeric-field="month"
						data-ame-active="false"
						aria-label={m.ameMonthLabel}
						aria-describedby="ame-field-error-month"
					>
						<span class="talc-ame-field-label">{m.ameMonthLabel}</span>
						<span class="talc-ame-field-value is-placeholder" data-talc-segment-value>
							{m.monthPlaceholder}
						</span>
						<AmeFieldError fieldId="month" />
					</button>
					<button
						type="button"
						class="talc-ame-field"
						data-ame-numeric-field="day"
						data-ame-active="false"
						aria-label={m.ameDayLabel}
						aria-describedby="ame-field-error-day"
					>
						<span class="talc-ame-field-label">{m.ameDayLabel}</span>
						<span class="talc-ame-field-value is-placeholder" data-talc-segment-value>
							{m.dayPlaceholder}
						</span>
						<AmeFieldError fieldId="day" />
					</button>
				</div>

				<div
					class="talc-leave-system talc-ame-leave"
					role="group"
					aria-label={m.leaveSystemGroupAriaLabel}
					data-talc-ame-leave-system
				>
					<button
						type="button"
						class="talc-leave-option is-active"
						data-talc-ame-leave="anniversary"
						aria-pressed="true"
					>
						{m.anniversaryLabel}
					</button>
					<button
						type="button"
						class="talc-leave-option"
						data-talc-ame-leave="calendar-year"
						aria-pressed="false"
					>
						{m.calendarYearLabel}
					</button>
				</div>
			</div>
		</AdaptiveMobileEditor>

		<Fragment slot="drawerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerContent">
			<section class="pb-12" aria-labelledby="talc-about-heading">
				<h2 id="talc-about-heading" class="mb-2 text-lg font-semibold text-white">
					{m.about.heading}
				</h2>
				<p class="text-sm leading-relaxed text-slate-400">{m.about.body}</p>
			</section>

			<section class="pb-12" aria-labelledby="talc-howto-heading">
				<h2 id="talc-howto-heading" class="mb-2 text-lg font-semibold text-white">
					{m.howTo.heading}
				</h2>
				<ol class="list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-400">
					{m.howTo.steps.map((step) => <li>{step}</li>)}
				</ol>
				<p class="mt-4 text-sm leading-relaxed text-slate-400">{m.howTo.note}</p>
			</section>

			<section class="pb-12" aria-labelledby="talc-tags-heading">
				<h2 id="talc-tags-heading" class="mb-4 text-lg font-semibold text-white">
					{m.commonUses.heading}
				</h2>
				<ul class="tool-keyword-list" role="list">
					{m.commonUses.items.map((item) => <li class="tool-keyword-chip">{item}</li>)}
				</ul>
			</section>

			<section class="pb-12" aria-labelledby="talc-faq-heading">
				<h2 id="talc-faq-heading" class="mb-4 text-lg font-semibold text-white">
					{m.faq.heading}
				</h2>
				<div class="border-t border-white/20">
					{
						m.faq.items.map((item) => (
							<details class="group border-b border-white/20 py-4">
								<summary class="flex list-none items-center justify-between gap-4 font-medium text-white [&::-webkit-details-marker]:hidden">
									<span>{item.question}</span>
									<span class="relative flex h-4 w-4 shrink-0 items-center justify-center text-slate-400">
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 16 16"
											fill="none"
											class="h-4 w-4 group-open:hidden"
											aria-hidden="true"
										>
											<path
												d="M8 3.5v9M3.5 8h9"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"></path>
										</svg>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 16 16"
											fill="none"
											class="hidden h-4 w-4 group-open:block"
											aria-hidden="true"
										>
											<path
												d="M3.5 8h9"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"></path>
										</svg>
									</span>
								</summary>
								<p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
							</details>
						))
					}
				</div>
			</section>

			<section aria-labelledby="talc-legal-heading">
				<h2 id="talc-legal-heading" class="mb-2 text-lg font-semibold text-white">
					{m.legal.heading}
				</h2>
				<p class="text-sm leading-relaxed text-slate-400">{m.legal.body}</p>
				<ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-400">
					{
						m.legal.sources.map((source) => (
							<li>
								<a
									href={source.href}
									class="text-slate-300 underline decoration-white/20 underline-offset-2 transition-colors hover:text-white hover:decoration-white/40"
									target="_blank"
									rel="noopener noreferrer"
								>
									{source.label}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</Fragment>
	</ToolPageFrame>

	{/* Shared DesktopCalendar — popover-compact；tool 只做 trigger／anchor */}
	<DesktopCalendar
		variant="popover-compact"
		idPrefix="talc-calendar-popover"
		weekdays={[...m.weekdays]}
		labels={{
			calendar: m.calendarLabel,
			previousMonth: m.previousMonth,
			nextMonth: m.nextMonth,
			month: m.monthFieldLabel,
			year: m.yearFieldLabel,
		}}
	/>
</div>

<script>
	import "../../../scripts/taiwan-annual-leave-calculator";
</script>
