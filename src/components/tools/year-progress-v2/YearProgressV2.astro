---
import RelatedToolRow from "../../RelatedToolRow.astro";
import ToolAdSlot from "../../ToolAdSlot.astro";
import ToolCard from "../../ToolCard.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getRelatedTools, type CatalogToolId } from "../../../data/toolsCatalog";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getYearProgressClientI18n } from "../../../i18n/clientMessages";
import { getMessages } from "../../../i18n/messages";
import { TOOL_THEMES } from "../../../lib/toolThemes";
import { buildYearProgressMonthlyNotesRegistry } from "../../../lib/yearProgressMonthlyNotes";

const rawMonthlyNoteModules = import.meta.glob(
	"../../../content/year-progress/monthly-notes/*/*.md",
	{ query: "?raw", import: "default", eager: true },
);

const monthlyNotesRegistry = buildYearProgressMonthlyNotesRegistry(rawMonthlyNoteModules);

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.yearProgress;
const relatedTools = getRelatedTools("year-progress");

const toolCopy: Record<
	CatalogToolId,
	{ title: string; relatedDescription: string }
> = {
	"event-countdown": messages.tools.eventCountdown,
	"date-range": messages.tools.dateRange,
	"countdown-timer": messages.tools.countdownTimer,
	"year-progress": messages.tools.yearProgress,
	"age-calculator": messages.tools.ageCalculator,
	"days-between-dates": messages.tools.daysBetweenDates,
	"business-days-calculator": messages.tools.businessDaysCalculator,
	"life-progress": messages.tools.lifeProgress,
	"date-calculator": messages.tools.dateCalculator,
	"hours-calculator": messages.tools.hoursCalculator,
};

const relatedToolItems = relatedTools.map((tool) => ({
	href: getLocalizedPath(locale, `/${tool.slug}/`),
	name: toolCopy[tool.id].title,
	description: toolCopy[tool.id].relatedDescription,
	icon: catalogIconMap[tool.id],
}));

const faqSchema = buildFaqPageJsonLd(m.faq.items);
const clientI18n = getYearProgressClientI18n(locale);
---

<div
	data-year-progress-v2
	data-tool-theme="mist"
	data-ypv2-locale={locale}
	data-ypv2-storage-key="timiva.yearProgress.state"
	data-ypv2-monthly-notes={JSON.stringify(monthlyNotesRegistry)}
	data-ypv2-client-i18n={JSON.stringify(clientI18n)}
>
	<script
		is:inline
		define:vars={{
			ypv2ValidThemesJson: JSON.stringify(TOOL_THEMES),
			ypv2FallbackStorageKey: "timiva.yearProgress.state",
		}}
	>
		(function () {
			var root = document.currentScript && document.currentScript.parentElement;
			if (!root || root.getAttribute("data-year-progress-v2") === null) return;

			var storageKey =
				root.getAttribute("data-ypv2-storage-key") || ypv2FallbackStorageKey;
			var validThemes = JSON.parse(ypv2ValidThemesJson);

			function isValidThemeId(value) {
				return (
					typeof value === "string" &&
					validThemes.indexOf(value) !== -1
				);
			}

			function isValidIsoDateString(value) {
				return (
					typeof value === "string" && Number.isFinite(Date.parse(value))
				);
			}

			function parseStoredState(raw) {
				var parsed;

				try {
					parsed = JSON.parse(raw);
				} catch (error) {
					return null;
				}

				if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
					return null;
				}

				if (!isValidThemeId(parsed.theme)) {
					return null;
				}

				if (
					typeof parsed.updatedAt !== "string" ||
					!isValidIsoDateString(parsed.updatedAt)
				) {
					return null;
				}

				return parsed;
			}

			function readThemeFromUrl() {
				try {
					var params = new URLSearchParams(window.location.search);
					var theme = params.get("theme");

					if (theme === null || theme === "") {
						return null;
					}

					if (validThemes.indexOf(theme) !== -1) {
						return theme;
					}

					return null;
				} catch (error) {
					return null;
				}
			}

			var urlTheme = readThemeFromUrl();
			var storageTheme = null;

			try {
				var raw = localStorage.getItem(storageKey);

				if (raw !== null) {
					var state = parseStoredState(raw);

					if (state) {
						storageTheme = state.theme;
					}
				}
			} catch (error) {
				/* Storage unavailable — URL theme may still apply. */
			}

			var initialTheme = urlTheme || storageTheme;

			if (initialTheme) {
				root.setAttribute("data-tool-theme", initialTheme);
				root.setAttribute("data-ypv2-theme-bootstrapped", "true");
			}
		})();
	</script>
	<div class="ypv2-page-theme-backdrop" aria-hidden="true"></div>
	<section data-ypv2-main-tool class="preview-tool-main-section px-6">
		<div class="preview-tool-first-screen">
			<div class="preview-tool-stage tool-stage mx-auto w-full max-w-md md:max-w-lg">
				<div
					class="preview-tool-result-group text-center is-pending"
					data-ypv2-result-stage
					aria-busy="true"
				>
					<h1
						class="preview-tool-landscape-compact-title ypv2-h1 ypv2-tool-name text-sm font-medium tracking-normal text-slate-300 md:text-base"
					>
						{m.h1}
					</h1>

					<p
						class="ypv2-year-headline preview-tool-result-label text-xs text-slate-400"
						data-ypv2-year-headline
					></p>

					<p
						class="ypv2-percentage preview-tool-result-number leading-none font-normal tracking-tight tabular-nums"
						data-ypv2-percent
					>
						<span class="ypv2-percent-value" data-ypv2-percent-value></span><span
							class="ypv2-percent-symbol"
							aria-hidden="true">%</span
						>
					</p>

					<p
						class="ypv2-days-row preview-tool-result-label text-xs text-slate-400 md:text-sm"
						data-ypv2-days-row
					>
						<span data-ypv2-days-passed></span><span
							class="ypv2-days-separator"
							aria-hidden="true">{m.staticDaysSeparator}</span
						><span data-ypv2-days-remaining></span>
					</p>

					<span
						class="ypv2-rhythm-divider preview-tool-landscape-hide"
						aria-hidden="true"
					></span>

					<div class="ypv2-rhythm-block preview-tool-landscape-hide">
						<p class="ypv2-monthly-note" data-ypv2-note></p>

						<div
							class="ypv2-segments"
							data-ypv2-segments
							role="img"
							aria-label={m.segmentsAriaLabel}
						>
							{
								Array.from({ length: 12 }, (_, index) => (
									<span class="ypv2-segment" data-ypv2-segment={index + 1}>
										<span class="ypv2-segment-fill" data-ypv2-segment-fill />
									</span>
								))
							}
						</div>
					</div>

					<noscript>
						<p class="ypv2-noscript-notice">
							{
								locale === "zh"
									? "需要啟用 JavaScript 才能顯示即時的今年進度。"
									: "Enable JavaScript to see your current year progress."
							}
						</p>
					</noscript>
				</div>

				<div
					class="ypv2-controls preview-tool-controls flex flex-wrap justify-center gap-3 md:gap-4"
					aria-label={m.controlsAriaLabel}
				>
					<button
						type="button"
						data-ypv2-theme-button
						class="preview-tool-control-btn tool-utility-control ypv2-control-btn inline-flex min-h-10 items-center justify-center rounded-full px-4 py-2 text-sm font-medium md:min-h-11 md:px-5 md:py-2.5"
					>
						{m.theme}
					</button>
					<button
						type="button"
						data-ypv2-share-button
						class="preview-tool-control-btn tool-utility-control ypv2-control-btn inline-flex min-h-10 items-center justify-center rounded-full px-4 py-2 text-sm font-medium md:min-h-11 md:px-5 md:py-2.5"
						aria-label={m.share}
					>
						{m.share}
					</button>
				</div>
			</div>
		</div>
	</section>

	<aside
		data-ypv2-drawer
		data-open="true"
		aria-label={m.relatedToolsDrawerAriaLabel}
		class="pointer-events-none fixed inset-y-0 right-0 z-20 hidden xl:block"
	>
		<span class="hidden translate-x-[300px]" aria-hidden="true"></span>
		<div
			data-ypv2-drawer-shell
			data-open="true"
			class="preview-tool-drawer-frosted pointer-events-auto relative flex h-dvh rounded-tl-3xl rounded-bl-3xl border-l border-white/10 shadow-2xl shadow-black/25 ring-1 ring-inset ring-white/[0.04] transition-transform duration-200 ease-out"
		>
			<button
				type="button"
				data-ypv2-drawer-toggle
				aria-expanded="true"
				class="relative z-10 flex w-14 shrink-0 items-center justify-center self-stretch text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
				aria-label={m.toggleRelatedToolsDrawerAriaLabel}
			>
				<svg
					data-drawer-arrow-open
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="h-7 w-7"
					aria-hidden="true"
				>
					<path
						d="M10 3L5 8l5 5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				<svg
					data-drawer-arrow-closed
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="hidden h-7 w-7"
					aria-hidden="true"
				>
					<path
						d="M6 3l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>

			<div
				data-ypv2-drawer-panel
				class="relative z-10 flex h-full w-[300px] shrink-0 flex-col"
			>
				<div class="px-5 pb-3 pt-5">
					<h2 class="text-lg font-semibold text-white">{messages.relatedTools.heading}</h2>
				</div>
				<ToolAdSlot variant="sidebar" locale={locale} state="is-disabled" />
				<div class="flex-1 space-y-3 overflow-y-auto px-5 pb-5" data-ypv2-drawer-related-tools>
					{
						relatedToolItems.map((tool) => (
							<div>
								<ToolCard
									href={tool.href}
									name={tool.name}
									description={tool.description}
									icon={tool.icon}
								/>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</aside>

	<div class="tool-lower-content mx-auto max-w-3xl px-6 pb-20 text-left" data-ypv2-lower-content>
		<ToolAdSlot variant="main" locale={locale} state="is-disabled" />

		<section
			data-ypv2-related-tools
			class="pb-12 xl:hidden"
			aria-labelledby="ypv2-related-heading"
		>
			<h2 id="ypv2-related-heading" class="mb-4 text-lg font-semibold text-white">
				{messages.relatedTools.heading}
			</h2>
			<div class="space-y-3" data-ypv2-mobile-related-tools>
				{
					relatedToolItems.map((tool) => (
						<RelatedToolRow
							href={tool.href}
							name={tool.name}
							description={tool.description}
							icon={tool.icon}
						/>
					))
				}
			</div>
		</section>

		<section class="pb-12" aria-labelledby="ypv2-about-heading">
			<h2 id="ypv2-about-heading" class="mb-2 text-lg font-semibold text-white">
				{m.about.heading}
			</h2>
			<p class="text-sm leading-relaxed text-slate-400">{m.about.body}</p>
		</section>

		<section class="pb-12" aria-labelledby="ypv2-howto-heading">
			<h2 id="ypv2-howto-heading" class="mb-2 text-lg font-semibold text-white">
				{m.howTo.heading}
			</h2>
			<p class="text-sm leading-relaxed text-slate-400">{m.howTo.body}</p>
		</section>

		<section class="pb-12" aria-labelledby="ypv2-tags-heading">
			<h2 id="ypv2-tags-heading" class="mb-4 text-lg font-semibold text-white">
				{m.tags.heading}
			</h2>
			<ul class="ypv2-keyword-list" role="list">
				{
					m.tags.items.map((item) => (
						<li class="ypv2-keyword-chip">{item}</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="ypv2-faq-heading">
			<h2 id="ypv2-faq-heading" class="mb-4 text-lg font-semibold text-white">
				{m.faq.heading}
			</h2>
			<div class="border-t border-white/20">
				{
					m.faq.items.map((item) => (
						<details class="group border-b border-white/20 py-4">
							<summary
								class="flex list-none items-center justify-between gap-4 font-medium text-white [&::-webkit-details-marker]:hidden"
							>
								<span>{item.question}</span>
								<span class="relative flex h-4 w-4 shrink-0 items-center justify-center text-slate-400">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 16 16"
										fill="none"
										class="h-4 w-4 group-open:hidden"
										aria-hidden="true"
									>
										<path
											d="M8 3.5v9M3.5 8h9"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"></path>
									</svg>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 16 16"
										fill="none"
										class="hidden h-4 w-4 group-open:block"
										aria-hidden="true"
									>
										<path
											d="M3.5 8h9"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"></path>
									</svg>
								</span>
							</summary>
							<p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
						</details>
					))
				}
			</div>
		</section>
	</div>

	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</div>

<script>
	import "../../../scripts/year-progress";
</script>

<script is:inline>
	document.addEventListener("DOMContentLoaded", () => {
		const root = document.querySelector("[data-year-progress-v2]");
		const drawer = root?.querySelector("[data-ypv2-drawer]");
		const shell = root?.querySelector("[data-ypv2-drawer-shell]");
		const toggle = root?.querySelector("[data-ypv2-drawer-toggle]");
		const related = root?.querySelector("[data-ypv2-related-tools]");
		const arrowOpen = root?.querySelector("[data-drawer-arrow-open]");
		const arrowClosed = root?.querySelector("[data-drawer-arrow-closed]");

		if (!drawer || !shell || !toggle) return;

		let isOpen = drawer.dataset.open !== "false";

		const sync = () => {
			drawer.dataset.open = isOpen ? "true" : "false";
			shell.dataset.open = isOpen ? "true" : "false";
			shell.classList.toggle("translate-x-[300px]", !isOpen);
			related?.classList.toggle("xl:hidden", isOpen);
			arrowOpen?.classList.toggle("hidden", !isOpen);
			arrowClosed?.classList.toggle("hidden", isOpen);
			toggle.setAttribute("aria-expanded", String(isOpen));
		};

		sync();

		toggle.addEventListener("click", (event) => {
			event.preventDefault();
			isOpen = !isOpen;
			sync();
		});
	});
</script>
