---
/**
 * Taiwan Year & Age Reference V2 — ToolPageFrame adopter.
 * B0: shell · B1A: lower content · B1B: 上方靜態畫面 · B2B: Desktop interaction。
 * 不接 AME／Mobile（B2C）。
 */
import RelatedToolRow from "../../RelatedToolRow.astro";
import ResultSummary from "../shared/ResultSummary.astro";
import ToolPageFrame from "../shared/ToolPageFrame.astro";
import AdaptiveMobileEditor from "../shared/AdaptiveMobileEditor.astro";
import AmeFieldError from "../shared/AmeFieldError.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import { getCatalogTool, type CatalogToolId } from "../../../data/toolsCatalog";
import { ERAS } from "../../../lib/japaneseEraConverterData";
import { TYAR_ZODIAC_IDS } from "../../../lib/taiwanYearAgeReferenceMath";
import "../../../styles/tools/taiwan-year-age-reference-v2.css";
import "../../../styles/tools/adaptive-mobile-editor.css";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.taiwanYearAgeReference;
const faqSchema = buildFaqPageJsonLd(m.faq.items);

/** Tool-local outbound only — exactly 3；不改 toolsCatalog、無 featured padding。 */
const declaredRelatedIds = [
	"japanese-era-converter",
	"age-calculator",
	"lunar-date-converter",
] as const satisfies readonly CatalogToolId[];

const toolCopy: Record<
	(typeof declaredRelatedIds)[number],
	{ title: string; relatedDescription: string }
> = {
	"japanese-era-converter": messages.tools.japaneseEraConverter,
	"age-calculator": messages.tools.ageCalculator,
	"lunar-date-converter": messages.tools.lunarDateConverter,
};

const relatedToolItems = declaredRelatedIds
	.map((id) => getCatalogTool(id))
	.filter((tool): tool is NonNullable<typeof tool> => Boolean(tool?.available))
	.map((tool) => {
		const id = tool.id as (typeof declaredRelatedIds)[number];
		return {
			href: getLocalizedPath(locale, `/${tool.slug}/`),
			name: toolCopy[id].title,
			description: toolCopy[id].relatedDescription,
			icon: catalogIconMap[tool.id],
		};
	});

const rsPrimary = {
	text: m.resultPlaceholder,
	ariaLabel: m.resultsLabel,
};

const eraCaret = `<svg class="tyar-era-caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.25 6 7.75l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
const modeSwitchIconHtml =
	'<svg class="tool-mode-switch-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 2.75v10.5M5 13.25 2.6 10.85M5 13.25l2.4-2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11 13.25V2.75M11 2.75 8.6 5.15M11 2.75l2.4 2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
const fieldErrorMark = `<span class="tyar-inline-error-mark" aria-hidden="true"><svg viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path><path fill="#0f172a" d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"></path></svg></span>`;
const eraOptionCheck = `<svg class="tyar-era-option-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.25 6.4 11.1 12.5 4.75" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
---

<div
	data-taiwan-year-age-reference-v2
	data-tyar-locale={locale === "zh" ? "zh" : "en"}
	data-tyar-phase="b2b-desktop"
	data-tyar-fixture="initial"
	data-tyar-query-mode="year"
>
	<ToolPageFrame
		locale={locale}
		relatedDrawerAriaLabel={m.relatedToolsDrawerAriaLabel}
		toggleRelatedDrawerAriaLabel={m.toggleRelatedToolsDrawerAriaLabel}
		relatedHeading={m.relatedToolsHeading}
		mobileControlsAriaLabel={m.mobileControlsAriaLabel}
	>
		{/* 第一屏 H1：不放 short description */}
		<Fragment slot="title">{m.kicker}</Fragment>

		<div slot="result" class="tyar-result-host">
			{/*
			  Initial「？」字級：blocking inline 對齊 TALC empty-result，
			  避免 shared textual 5rem 先 paint。
			*/}
			<style is:inline>
				[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
					[data-result-summary][data-rs-content="textual"],
				[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
				[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
					--rs-textual-primary-size: clamp(7.5rem, 38vw, 10.5rem);
				}
				@media (min-width: 768px) {
					[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
						[data-result-summary][data-rs-content="textual"],
					[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
					[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: 13rem;
					}
				}
				@media (orientation: landscape) and (max-height: 700px) and (max-width: 1200px) and (hover: none) {
					[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
						[data-result-summary][data-rs-content="textual"],
					[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
					[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"],
					[data-taiwan-year-age-reference-v2][data-tyar-fixture="initial"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"] {
						--rs-textual-primary-size: 3.75rem;
					}
				}
			</style>

			<div class="tyar-primary-row">
				<button
					type="button"
					class="tyar-year-chip tyar-landscape-nav"
					data-tyar-chip="prev"
					hidden
					disabled
					tabindex="-1"
				>
				</button>
				<ResultSummary
					content="textual"
					layout="desktop"
					variant="spacious"
					ariaLabel={m.resultsLabel}
					primary={rsPrimary}
					weekday={null}
					support={null}
					class="tyar-result-summary"
				/>
				<button
					type="button"
					class="tyar-year-chip tyar-landscape-nav"
					data-tyar-chip="next"
					hidden
					disabled
					tabindex="-1"
				>
				</button>
			</div>

			<div class="tyar-result-meta tool-textual-result-support-divider">
				<p class="tyar-lead" data-tyar-lead>{m.resultInitialSupport}</p>
				<p class="tyar-then-taiwan" data-tyar-then-taiwan hidden></p>
				{/* Desktop／Portrait Reverse：置中 compact pair。Landscape Reverse 改走左右 chips。 */}
				<div class="tyar-reverse-nav" data-tyar-reverse-nav hidden>
					<button
						type="button"
						class="tyar-year-chip"
						data-tyar-chip="prev"
						hidden
						disabled
						tabindex="-1"
					>
					</button>
					<button
						type="button"
						class="tyar-year-chip"
						data-tyar-chip="current"
						hidden
						disabled
						tabindex="-1"
					>
					</button>
					<button
						type="button"
						class="tyar-year-chip"
						data-tyar-chip="next"
						hidden
						disabled
						tabindex="-1"
					>
					</button>
				</div>
			</div>
		</div>

		{/* Desktop：Year lookup 或 Zodiac lookup（互斥 static）；Reset 維持原位 */}
		<div
			slot="desktopControls"
			class="tyar-desktop-cluster tool-standard-pill-field-cluster"
			aria-label={m.upperControlsAriaLabel}
		>
			<div class="tyar-year-mode" data-tyar-year-mode>
				<button
					type="button"
					class="tool-mode-switch"
					data-tyar-query-switch="zodiac"
				>
					<Fragment set:html={modeSwitchIconHtml} />
					<span>{m.switchToZodiacLookup}</span>
				</button>

				<div class="tyar-mode-group" role="group" aria-label={m.modeGroupAriaLabel} data-tyar-mode-group>
					<button
						type="button"
						class="tyar-mode-option is-active"
						data-tyar-mode="gregorian"
						aria-pressed="true"
					>
						{m.modeGregorian}
					</button>
					<button
						type="button"
						class="tyar-mode-option"
						data-tyar-mode="minguo"
						aria-pressed="false"
					>
						{m.modeMinguo}
					</button>
					<button
						type="button"
						class="tyar-mode-option"
						data-tyar-mode="era"
						aria-pressed="false"
					>
						{m.modeEra}
					</button>
				</div>

				<div class="tyar-field-wrap" data-tyar-field="gregorian">
					<div class="tyar-field-shell">
						<span class="tyar-field-prefix">{m.gregorianPrefix}</span>
						<span class="tyar-field-divider" aria-hidden="true"></span>
						<input
							type="text"
							class="tyar-year-input"
							data-tyar-gregorian-year
							inputmode="numeric"
							autocomplete="off"
							spellcheck="false"
							maxlength="4"
							aria-label={m.gregorianYearAriaLabel}
							placeholder={m.gregorianYearPlaceholder}
							aria-invalid="false"
							value=""
						/>
						<span
							class="tyar-inline-error"
							id="tyar-gregorian-inline-error"
							data-tyar-gregorian-error
							hidden
							role="status"
						>
							<Fragment set:html={fieldErrorMark} />
						</span>
					</div>
				</div>

				<div class="tyar-field-wrap" data-tyar-field="minguo" hidden>
					<div class="tyar-field-shell">
						<span class="tyar-field-prefix">{m.minguoPrefix}</span>
						<span class="tyar-field-divider" aria-hidden="true"></span>
						<input
							type="text"
							class="tyar-year-input"
							data-tyar-minguo-year
							inputmode="numeric"
							autocomplete="off"
							spellcheck="false"
							maxlength="3"
							aria-label={m.minguoYearAriaLabel}
							placeholder={m.minguoYearPlaceholder}
							aria-invalid="false"
							value=""
						/>
						<span
							class="tyar-inline-error"
							id="tyar-minguo-inline-error"
							data-tyar-minguo-error
							hidden
							role="status"
						>
							<Fragment set:html={fieldErrorMark} />
						</span>
					</div>
				</div>

				<div class="tyar-field-wrap" data-tyar-field="era" hidden>
					<div class="tyar-field-shell">
						<button
							type="button"
							class="tyar-era-prefix"
							data-tyar-era-prefix
							aria-haspopup="listbox"
							aria-expanded="false"
							aria-controls="tyar-era-listbox"
							aria-label={m.eraSelectorAriaLabel}
						>
							<span data-tyar-era-label>{m.eraNames.reiwa}</span>
							<Fragment set:html={eraCaret} />
						</button>
						<span class="tyar-field-divider" aria-hidden="true"></span>
							<input
								type="text"
								class="tyar-year-input"
								data-tyar-era-year
								inputmode="numeric"
								autocomplete="off"
								spellcheck="false"
								maxlength="2"
								size="2"
								aria-label={m.eraYearAriaLabel}
							placeholder={m.eraYearPlaceholder}
							aria-invalid="false"
							value=""
						/>
						<span
							class="tyar-inline-error"
							id="tyar-era-inline-error"
							data-tyar-era-error
							hidden
							role="status"
						>
							<span data-tyar-era-error-text></span>
							<Fragment set:html={fieldErrorMark} />
						</span>
					</div>
					<div
						class="tyar-era-popover"
						id="tyar-era-listbox"
						data-tyar-era-popover
						role="listbox"
						hidden
						aria-label={m.eraSelectorAriaLabel}
					>
						{
							ERAS.map((era) => (
								<button
									type="button"
									class="tyar-era-option"
									role="option"
									data-tyar-era-option={era.id}
									aria-selected={era.id === "reiwa" ? "true" : "false"}
									tabindex="-1"
								>
									<span>{m.eraNames[era.id]}</span>
									<Fragment set:html={eraOptionCheck} />
								</button>
							))
						}
					</div>
				</div>
			</div>

			<div class="tyar-zodiac-mode" data-tyar-zodiac-mode hidden>
				<button
					type="button"
					class="tool-mode-switch"
					data-tyar-query-switch="year"
				>
					<Fragment set:html={modeSwitchIconHtml} />
					<span>{m.switchToYearLookup}</span>
				</button>

				<div class="tyar-zodiac-row">
					<div class="tyar-mini-field" data-tyar-zodiac-wrap>
						<div class="tyar-field-shell">
							<select
								class="tyar-zodiac-select is-placeholder"
								data-tyar-zodiac
								aria-label={m.zodiacLabel}
								aria-invalid="false"
							>
								<option value="">{m.zodiacPlaceholder}</option>
								{TYAR_ZODIAC_IDS.map((id) => (
									<option value={id}>{m.zodiacNames[id]}</option>
								))}
							</select>
							<span class="tyar-select-caret" aria-hidden="true">
								<Fragment set:html={eraCaret} />
							</span>
							<span
								class="tyar-inline-error"
								id="tyar-zodiac-inline-error"
								data-tyar-zodiac-error
								hidden
								role="status"
							>
								<Fragment set:html={fieldErrorMark} />
							</span>
						</div>
					</div>
					<div class="tyar-mini-field" data-tyar-age-wrap>
						<div class="tyar-field-shell">
							<input
								type="text"
								class="tyar-age-input"
								data-tyar-age
								inputmode="numeric"
								autocomplete="off"
								spellcheck="false"
								maxlength="3"
								aria-label={m.ageLabel}
								placeholder={m.agePlaceholder}
								aria-invalid="false"
								value=""
							/>
							<span
								class="tyar-inline-error"
								id="tyar-age-inline-error"
								data-tyar-age-error
								hidden
								role="status"
							>
								<Fragment set:html={fieldErrorMark} />
							</span>
						</div>
					</div>
				</div>
			</div>

			<button
				type="button"
				class="tool-text-action--muted tyar-reset"
				data-tyar-reset
			>
				{m.resetLabel}
			</button>
		</div>

		{/*
		  手機第一屏：capsule only。
		  填「查詢年份」文案，維持 disabled（不開 sheet）。
		*/}
		<button
			slot="mobilePrimaryControl"
			type="button"
			class="preview-tool-control-btn tool-primary-entry-capsule"
			data-tyar-capsule
			disabled
			aria-disabled="true"
			aria-label={m.capsuleLabel}
		>
			{m.capsuleLabel}
		</button>

		<AdaptiveMobileEditor
			slot="ame"
			id="tyar-ame"
			locale={locale}
			ariaLabel={m.sheetAriaLabel}
			title={m.sheetTitle}
			showCancel={false}
		>
			{/* 蓋掉 AME 預設 lab fixture 文案 */}
			<span hidden></span>
			<div slot="content" class="tyar-ame-form" data-tyar-ame-form>
				<div class="tyar-ame-panel" data-tyar-ame-panel="year">
					<div
						class="tyar-mode-group"
						role="group"
						aria-label={m.modeGroupAriaLabel}
						data-tyar-ame-mode-group
					>
						<button
							type="button"
							class="tyar-mode-option is-active"
							data-tyar-ame-mode="gregorian"
							disabled
							aria-disabled="true"
							aria-pressed="true"
						>
							{m.modeGregorian}
						</button>
						<button
							type="button"
							class="tyar-mode-option"
							data-tyar-ame-mode="minguo"
							disabled
							aria-disabled="true"
							aria-pressed="false"
						>
							{m.modeMinguo}
						</button>
						<button
							type="button"
							class="tyar-mode-option"
							data-tyar-ame-mode="era"
							disabled
							aria-disabled="true"
							aria-pressed="false"
						>
							{m.modeEra}
						</button>
					</div>

					{/* 年份欄：JEC／Lunar AME setting-row，非 Desktop compound field */}
					<div class="tyar-ame-field-block" data-tyar-ame-field="gregorian">
						<button
							type="button"
							class="ame-setting-row ame-numeric-field tyar-ame-year-row"
							data-ame-numeric-field="gregorianYear"
							data-ame-active="false"
							disabled
							aria-disabled="true"
							tabindex="-1"
							aria-label={m.gregorianYearAriaLabel}
							aria-invalid="false"
							aria-describedby="ame-field-error-gregorianYear"
						>
							<span class="ame-setting-label ame-numeric-label">{m.gregorianPrefix}</span>
							<span class="ame-setting-control">
								<span
									class="ame-numeric-value ame-numeric-value--placeholder"
									data-ame-numeric-value
									data-tyar-ame-gregorian-year
									data-placeholder={m.gregorianYearPlaceholder}
								>
									{m.gregorianYearPlaceholder}
								</span>
								<AmeFieldError fieldId="gregorianYear" />
							</span>
						</button>
					</div>
					<div class="tyar-ame-field-block" data-tyar-ame-field="minguo" hidden>
						<button
							type="button"
							class="ame-setting-row ame-numeric-field tyar-ame-year-row"
							data-ame-numeric-field="minguoYear"
							data-ame-active="false"
							disabled
							aria-disabled="true"
							tabindex="-1"
							aria-label={m.minguoYearAriaLabel}
							aria-invalid="false"
							aria-describedby="ame-field-error-minguoYear"
						>
							<span class="ame-setting-label ame-numeric-label">{m.minguoPrefix}</span>
							<span class="ame-setting-control">
								<span
									class="ame-numeric-value ame-numeric-value--placeholder"
									data-ame-numeric-value
									data-tyar-ame-minguo-year
									data-placeholder={m.minguoYearPlaceholder}
								>
									{m.minguoYearPlaceholder}
								</span>
								<AmeFieldError fieldId="minguoYear" />
							</span>
						</button>
					</div>
					<div class="tyar-ame-field-block" data-tyar-ame-field="era" hidden>
						<button
							type="button"
							class="ame-setting-row ame-numeric-field tyar-ame-year-row"
							data-ame-numeric-field="eraYear"
							data-ame-active="false"
							disabled
							aria-disabled="true"
							tabindex="-1"
							aria-label={m.eraYearAriaLabel}
							aria-invalid="false"
							aria-describedby="ame-field-error-eraYear"
						>
							<span class="ame-setting-label ame-numeric-label" data-tyar-ame-era-label>
								{m.eraShowA}
							</span>
							<span class="ame-setting-control">
								<span
									class="ame-numeric-value ame-numeric-value--placeholder"
									data-ame-numeric-value
									data-tyar-ame-era-year
									data-placeholder={m.eraYearPlaceholder}
								>
									{m.eraYearPlaceholder}
								</span>
								<AmeFieldError fieldId="eraYear" />
							</span>
						</button>
					</div>

					<button
						type="button"
						class="tool-mode-switch"
						data-tyar-ame-query-switch="zodiac"
						disabled
						aria-disabled="true"
						tabindex="-1"
					>
						<Fragment set:html={modeSwitchIconHtml} />
						<span>{m.switchToZodiacLookup}</span>
					</button>
				</div>

				<div class="tyar-ame-panel" data-tyar-ame-panel="zodiac" hidden>
					<div class="tyar-ame-pair">
						<div class="tyar-ame-field">
							<span class="tyar-ame-field-label">{m.zodiacLabel}</span>
							<span
								class="tyar-ame-field-value is-placeholder"
								data-tyar-ame-zodiac
								data-placeholder={m.zodiacPlaceholder}>{m.zodiacPlaceholder}</span
							>
						</div>
						<div class="tyar-ame-field">
							<span class="tyar-ame-field-label">{m.ageLabel}</span>
							<span class="tyar-ame-field-value is-placeholder" data-tyar-ame-age></span>
						</div>
					</div>

					<button
						type="button"
						class="tool-mode-switch"
						data-tyar-ame-query-switch="year"
						disabled
						aria-disabled="true"
						tabindex="-1"
					>
						<Fragment set:html={modeSwitchIconHtml} />
						<span>{m.switchToYearLookup}</span>
					</button>
				</div>
			</div>
		</AdaptiveMobileEditor>

		<Fragment slot="drawerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

