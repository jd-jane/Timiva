---
/**
 * Taiwan Year & Age Reference V2 — ToolPageFrame adopter.
 * B0: shell scaffold.
 * B1A: lower content + Related Tools + FAQ JSON-LD.
 * 不做 B1B 靜態畫面、B2 互動／計算。
 */
import RelatedToolRow from "../../RelatedToolRow.astro";
import ToolPageFrame from "../shared/ToolPageFrame.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import { getCatalogTool, type CatalogToolId } from "../../../data/toolsCatalog";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.taiwanYearAgeReference;
const faqSchema = buildFaqPageJsonLd(m.faq.items);

/** Tool-local outbound only — exactly 3；不改 toolsCatalog、無 featured padding。 */
const declaredRelatedIds = [
	"japanese-era-converter",
	"age-calculator",
	"lunar-date-converter",
] as const satisfies readonly CatalogToolId[];

const toolCopy: Record<
	(typeof declaredRelatedIds)[number],
	{ title: string; relatedDescription: string }
> = {
	"japanese-era-converter": messages.tools.japaneseEraConverter,
	"age-calculator": messages.tools.ageCalculator,
	"lunar-date-converter": messages.tools.lunarDateConverter,
};

const relatedToolItems = declaredRelatedIds
	.map((id) => getCatalogTool(id))
	.filter((tool): tool is NonNullable<typeof tool> => Boolean(tool?.available))
	.map((tool) => {
		const id = tool.id as (typeof declaredRelatedIds)[number];
		return {
			href: getLocalizedPath(locale, `/${tool.slug}/`),
			name: toolCopy[id].title,
			description: toolCopy[id].relatedDescription,
			icon: catalogIconMap[tool.id],
		};
	});
---

<div
	data-taiwan-year-age-reference-v2
	data-tyar-locale={locale === "zh" ? "zh" : "en"}
	data-tyar-phase="b1a-lower-content"
>
	<ToolPageFrame
		locale={locale}
		relatedDrawerAriaLabel={m.relatedToolsDrawerAriaLabel}
		toggleRelatedDrawerAriaLabel={m.toggleRelatedToolsDrawerAriaLabel}
		relatedHeading={m.relatedToolsHeading}
		mobileControlsAriaLabel={m.mobileControlsAriaLabel}
	>
		{/* 第一屏 H1：不放 short description */}
		<Fragment slot="title">{m.kicker}</Fragment>

		{/* 結果區結構 placeholder：非正式 ResultSummary／正式視覺（B1B） */}
		<div
			slot="result"
			class="tyar-result-placeholder"
			role="status"
			aria-label={m.resultAriaLabel}
		>
			<span class="tyar-result-placeholder__value">{m.resultPlaceholder}</span>
		</div>

		{/*
		  Frame adopter contract 需要 mobilePrimaryControl。
		  維持 B0 disabled baseline（非 enabled no-op）。
		*/}
		<button
			slot="mobilePrimaryControl"
			type="button"
			class="preview-tool-control-btn tool-primary-entry-capsule"
			disabled
			aria-disabled="true"
			aria-label={m.mobilePrimaryControlPlaceholderAriaLabel}
		>
		</button>

		<Fragment slot="drawerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerContent">
			{/* About */}
			<section class="pb-12" aria-labelledby="tyar-about-heading">
				<h2 id="tyar-about-heading" class="mb-2 text-lg font-semibold text-white">
					{m.about.heading}
				</h2>
				<p class="text-sm leading-relaxed text-slate-400">{m.about.body}</p>
			</section>

			{/* How to use：單段正文，不拆未實作操作步驟 */}
			<section class="pb-12" aria-labelledby="tyar-howto-heading">
				<h2 id="tyar-howto-heading" class="mb-2 text-lg font-semibold text-white">
					{m.howTo.heading}
				</h2>
				<p class="text-sm leading-relaxed text-slate-400">{m.howTo.body}</p>
			</section>

			{/* Common uses / tags（非互動） */}
			<section class="pb-12" aria-labelledby="tyar-tags-heading">
				<h2 id="tyar-tags-heading" class="mb-4 text-lg font-semibold text-white">
					{m.commonUses.heading}
				</h2>
				<ul class="tool-keyword-list" role="list">
					{m.commonUses.items.map((item) => <li class="tool-keyword-chip">{item}</li>)}
				</ul>
			</section>

			{/* FAQ */}
			<section class="pb-12" aria-labelledby="tyar-faq-heading">
				<h2 id="tyar-faq-heading" class="mb-4 text-lg font-semibold text-white">
					{m.faq.heading}
				</h2>
				<div class="border-t border-white/20">
					{
						m.faq.items.map((item) => (
							<details class="group border-b border-white/20 py-4">
								<summary class="flex list-none items-center justify-between gap-4 font-medium text-white [&::-webkit-details-marker]:hidden">
									<span>{item.question}</span>
									<span class="relative flex h-4 w-4 shrink-0 items-center justify-center text-slate-400">
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 16 16"
											fill="none"
											class="h-4 w-4 group-open:hidden"
											aria-hidden="true"
										>
											<path
												d="M8 3.5v9M3.5 8h9"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"></path>
										</svg>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 16 16"
											fill="none"
											class="hidden h-4 w-4 group-open:block"
											aria-hidden="true"
										>
											<path
												d="M3.5 8h9"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"></path>
										</svg>
									</span>
								</summary>
								<p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
							</details>
						))
					}
				</div>
			</section>
		</Fragment>
	</ToolPageFrame>

	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</div>
