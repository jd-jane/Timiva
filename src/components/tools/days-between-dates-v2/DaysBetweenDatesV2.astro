---
import RelatedToolRow from "../../RelatedToolRow.astro";
import ToolAdSlot from "../../ToolAdSlot.astro";
import ToolCard from "../../ToolCard.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getRelatedTools, type CatalogToolId } from "../../../data/toolsCatalog";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import "../../../styles/tools/tool-mobile-sheet-v2-baseline.css";
/* Tool-local sheet overrides must load after shared MSB baseline */
import "../../../styles/tools/days-between-dates-v2.css";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.daysBetweenDates;
const relatedTools = getRelatedTools("days-between-dates");

const toolCopy: Record<
	CatalogToolId,
	{ title: string; relatedDescription: string }
> = {
	"event-countdown": messages.tools.eventCountdown,
	"date-range": messages.tools.dateRange,
	"countdown-timer": messages.tools.countdownTimer,
	"year-progress": messages.tools.yearProgress,
	"age-calculator": messages.tools.ageCalculator,
	"days-between-dates": messages.tools.daysBetweenDates,
	"business-days-calculator": messages.tools.businessDaysCalculator,
	"life-progress": messages.tools.lifeProgress,
	"date-calculator": messages.tools.dateCalculator,
};

const relatedToolItems = relatedTools.map((tool) => ({
	href: getLocalizedPath(locale, `/${tool.slug}/`),
	name: toolCopy[tool.id].title,
	description: toolCopy[tool.id].relatedDescription,
	icon: catalogIconMap[tool.id],
}));

const faqSchema = buildFaqPageJsonLd(m.faq.items);
const resultLocale = locale === "zh" ? "zh" : "en";
---

<div
	data-days-between-dates-v2
	data-dbdv2-result-locale={resultLocale}
	data-dbdv2-result-digits="1-3"
	data-dbdv2-include-label-off={m.includeBothDates}
	data-dbdv2-include-label-on={m.includeBothDatesActive}
>
	{/* B1B / B2B：第一屏結果 + 日期輸入 + Include */}
	<section data-dbdv2-main-tool class="preview-tool-main-section px-6">
		<div class="preview-tool-first-screen">
			<div class="preview-tool-stage tool-stage mx-auto w-full max-w-md md:max-w-lg">
				<div class="preview-tool-result-group text-center">
					<h1
						class="dbdv2-tool-name preview-tool-landscape-compact-title text-sm font-medium tracking-normal text-slate-300 md:text-base"
					>
						{m.kicker}
					</h1>

					<div class="preview-tool-result-block mt-6 md:mt-8">
						<p
							class="preview-tool-result-number leading-none font-normal tracking-tight tabular-nums"
							data-dbdv2-result-days
							aria-label={`0 ${m.primaryResultUnit}`}
						>
							0
						</p>
						<p
							class="preview-tool-result-label text-xs text-slate-400 md:text-sm"
							data-dbdv2-result-unit
						>
							{m.primaryResultUnit}
						</p>

						<span class="dbdv2-result-divider" aria-hidden="true"></span>

						<p
							class="dbdv2-secondary-line"
							data-dbdv2-result-weeks
						>
							{m.secondaryResultZero}
						</p>
					</div>
				</div>

				{/* Desktop：長型雙日期 Smart Date Input + Include */}
				<div
					class="dbdv2-input-cluster dbdv2-input-cluster--desktop"
					aria-label={m.upperControlsAriaLabel}
				>
					<div
						class="dbdv2-date-range-shell dbdv2-date-range-shell--desktop"
						role="group"
						aria-label={m.upperControlsAriaLabel}
					>
						<label class="dbdv2-desktop-field">
							<span class="sr-only">{m.fromDateLabel}</span>
							<span class="dbdv2-desktop-field-inner">
								<input
									type="text"
									class="dbdv2-date-input"
									data-dbdv2-desktop-from
									inputmode="numeric"
									autocomplete="off"
									spellcheck="false"
									aria-label={m.fromDateInputAriaLabel}
									placeholder={m.dateInputPlaceholder}
								/>
								<span
									class="dbdv2-date-invalid-icon"
									data-dbdv2-desktop-from-invalid
									hidden
									aria-label={m.invalidDateMessage}
								>
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											fill="currentColor"
											d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
										<path
											fill="#0f172a"
											d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
										></path>
									</svg>
								</span>
							</span>
						</label>
						<span class="dbdv2-date-separator" aria-hidden="true">—</span>
						<label class="dbdv2-desktop-field">
							<span class="sr-only">{m.toDateLabel}</span>
							<span class="dbdv2-desktop-field-inner">
								<input
									type="text"
									class="dbdv2-date-input"
									data-dbdv2-desktop-to
									inputmode="numeric"
									autocomplete="off"
									spellcheck="false"
									aria-label={m.toDateInputAriaLabel}
									placeholder={m.dateInputPlaceholder}
								/>
								<span
									class="dbdv2-date-invalid-icon"
									data-dbdv2-desktop-to-invalid
									hidden
									aria-label={m.invalidDateMessage}
								>
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											fill="currentColor"
											d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
										<path
											fill="#0f172a"
											d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
										></path>
									</svg>
								</span>
							</span>
						</label>
					</div>

					{/* Desktop：Include 純文字輔助選項（可切換；非膠囊） */}
					<div class="dbdv2-include-option-wrap">
						<button
							type="button"
							class="dbdv2-include-option"
							data-dbdv2-include-toggle
							aria-pressed="false"
						>
							{m.includeBothDates}
						</button>
					</div>
				</div>

				{/* Mobile：第一屏底部主要操作按鈕（日期範圍膠囊） */}
				<div
					class="preview-tool-controls dbdv2-mobile-controls flex flex-wrap justify-center gap-3"
					aria-label={m.upperControlsAriaLabel}
				>
					<button
						type="button"
						class="preview-tool-control-btn dbdv2-mobile-capsule inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 text-sm font-medium text-slate-300 backdrop-blur-sm"
						data-dbdv2-sheet-open
						aria-label={m.openDateSheetAriaLabel}
					>
						<span
							data-dbdv2-mobile-range
							data-dbdv2-empty-label={m.mobileSelectDates}
						>{m.mobileSelectDates}</span>
					</button>
				</div>
			</div>
		</div>
	</section>

	<aside
		data-dbdv2-drawer
		data-open="true"
		aria-label={m.relatedToolsDrawerAriaLabel}
		class="pointer-events-none fixed inset-y-0 right-0 z-20 hidden xl:block"
	>
		<span class="hidden translate-x-[300px]" aria-hidden="true"></span>
		<div
			data-dbdv2-drawer-shell
			data-open="true"
			class="preview-tool-drawer-frosted pointer-events-auto relative flex h-dvh rounded-tl-3xl rounded-bl-3xl border-l border-white/10 shadow-2xl shadow-black/25 ring-1 ring-inset ring-white/[0.04] transition-transform duration-200 ease-out"
		>
			<button
				type="button"
				data-dbdv2-drawer-toggle
				aria-expanded="true"
				class="relative z-10 flex w-14 shrink-0 items-center justify-center self-stretch text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
				aria-label={m.toggleRelatedToolsDrawerAriaLabel}
			>
				<svg
					data-drawer-arrow-open
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="h-7 w-7"
					aria-hidden="true"
				>
					<path
						d="M10 3L5 8l5 5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				<svg
					data-drawer-arrow-closed
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="hidden h-7 w-7"
					aria-hidden="true"
				>
					<path
						d="M6 3l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>

			<div
				data-dbdv2-drawer-panel
				class="relative z-10 flex h-full w-[300px] shrink-0 flex-col"
			>
				<div class="px-5 pb-3 pt-5">
					<h2 class="text-lg font-semibold text-white">{messages.relatedTools.heading}</h2>
				</div>
				<ToolAdSlot variant="sidebar" locale={locale} state="is-disabled" />
				<div class="flex-1 space-y-3 overflow-y-auto px-5 pb-5" data-dbdv2-drawer-related-tools>
					{
						relatedToolItems.map((tool) => (
							<div>
								<ToolCard
									href={tool.href}
									name={tool.name}
									description={tool.description}
									icon={tool.icon}
								/>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</aside>

	{/* B1A：下方內容層 — About / How to use / Common uses / FAQ + JSON-LD / Related Tools */}
	<div class="tool-lower-content mx-auto max-w-3xl px-6 pb-20 text-left" data-dbdv2-lower-content>
		<ToolAdSlot variant="main" locale={locale} state="is-disabled" />

		<section
			data-dbdv2-related-tools
			class="pb-12 xl:hidden"
			aria-labelledby="dbdv2-related-heading"
		>
			<h2 id="dbdv2-related-heading" class="mb-4 text-lg font-semibold text-white">
				{messages.relatedTools.heading}
			</h2>
			<div class="space-y-3" data-dbdv2-mobile-related-tools>
				{
					relatedToolItems.map((tool) => (
						<RelatedToolRow
							href={tool.href}
							name={tool.name}
							description={tool.description}
							icon={tool.icon}
						/>
					))
				}
			</div>
		</section>

		<section class="pb-12" aria-labelledby="dbdv2-about-heading">
			<h2 id="dbdv2-about-heading" class="mb-2 text-lg font-semibold text-white">
				{m.about.heading}
			</h2>
			<p class="text-sm leading-relaxed text-slate-400">{m.about.body}</p>
		</section>

		<section class="pb-12" aria-labelledby="dbdv2-howto-heading">
			<h2 id="dbdv2-howto-heading" class="mb-2 text-lg font-semibold text-white">
				{m.howTo.heading}
			</h2>
			<ol class="list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-400">
				{m.howTo.steps.map((step) => <li>{step}</li>)}
			</ol>
		</section>

		<section class="pb-12" aria-labelledby="dbdv2-tags-heading">
			<h2 id="dbdv2-tags-heading" class="mb-4 text-lg font-semibold text-white">
				{m.commonUses.heading}
			</h2>
			<ul class="dbdv2-keyword-list" role="list">
				{m.commonUses.items.map((item) => <li class="dbdv2-keyword-chip">{item}</li>)}
			</ul>
		</section>

		<section aria-labelledby="dbdv2-faq-heading">
			<h2 id="dbdv2-faq-heading" class="mb-4 text-lg font-semibold text-white">
				{m.faq.heading}
			</h2>
			<div class="border-t border-white/20">
				{
					m.faq.items.map((item) => (
						<details class="group border-b border-white/20 py-4">
							<summary class="flex list-none items-center justify-between gap-4 font-medium text-white [&::-webkit-details-marker]:hidden">
								<span>{item.question}</span>
								<span class="relative flex h-4 w-4 shrink-0 items-center justify-center text-slate-400">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 16 16"
										fill="none"
										class="h-4 w-4 group-open:hidden"
										aria-hidden="true"
									>
										<path
											d="M8 3.5v9M3.5 8h9"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"></path>
									</svg>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 16 16"
										fill="none"
										class="hidden h-4 w-4 group-open:block"
										aria-hidden="true"
									>
										<path
											d="M3.5 8h9"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"></path>
									</svg>
								</span>
							</summary>
							<p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
						</details>
					))
				}
			</div>
		</section>
	</div>
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

{/* B1B：Mobile sheet chrome（靜態欄位；僅最小 open/close） */}
<div data-dbdv2-sheet-portal data-mobile-sheet-baseline hidden aria-hidden="true">
	<div
		class="tool-operation-overlay"
		data-dbdv2-sheet-overlay
		data-tool-operation-overlay
		hidden
		aria-hidden="true"
	>
	</div>

	<div
		class="msb-sheet dbdv2-sheet"
		data-dbdv2-sheet
		role="dialog"
		aria-modal="true"
		aria-label={m.sheetAriaLabel}
		aria-hidden="true"
		inert
	>
		<div class="msb-sheet-handle" aria-hidden="true"></div>

		<div class="msb-sheet-body">
			<div class="msb-sheet-fields dbdv2-sheet-fields">
				<label class="msb-field" data-dbdv2-sheet-from-field>
					<span class="msb-input-shell">
						<span class="msb-input-prefix">{m.fromDateLabel}</span>
						<span class="dbdv2-sheet-input-wrap">
							<input
								type="text"
								class="msb-input dbdv2-date-input"
								data-dbdv2-sheet-from
								inputmode="numeric"
								autocomplete="off"
								spellcheck="false"
								aria-label={m.fromDateInputAriaLabel}
								placeholder={m.dateInputPlaceholder}
							/>
							<span
								class="dbdv2-date-invalid-icon"
								data-dbdv2-sheet-from-invalid
								hidden
								aria-label={m.invalidDateMessage}
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
									<path
										fill="#0f172a"
										d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
									></path>
								</svg>
							</span>
						</span>
					</span>
				</label>

				<label class="msb-field" data-dbdv2-sheet-to-field>
					<span class="msb-input-shell">
						<span class="msb-input-prefix">{m.toDateLabel}</span>
						<span class="dbdv2-sheet-input-wrap">
							<input
								type="text"
								class="msb-input dbdv2-date-input"
								data-dbdv2-sheet-to
								inputmode="numeric"
								autocomplete="off"
								spellcheck="false"
								aria-label={m.toDateInputAriaLabel}
								placeholder={m.dateInputPlaceholder}
							/>
							<span
								class="dbdv2-date-invalid-icon"
								data-dbdv2-sheet-to-invalid
								hidden
								aria-label={m.invalidDateMessage}
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
									<path
										fill="#0f172a"
										d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
									></path>
								</svg>
							</span>
						</span>
					</span>
				</label>
			</div>

			<div class="dbdv2-sheet-include-wrap">
				<button
					type="button"
					class="dbdv2-include-option"
					data-dbdv2-include-toggle
					aria-pressed="false"
				>
					{m.includeBothDates}
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	import "../../../scripts/days-between-dates";
</script>
