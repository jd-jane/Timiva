---
/**
 * Lunar Date Converter V2 — ToolPageFrame adopter.
 * B1A: lower content + temporary Related Tools wiring.
 * B1B: upper static visual (ResultSummary + desktop input + mode switch + mobile capsule).
 * No conversion logic, calendar interaction, AME, or direction state in B1B.
 */
import RelatedToolRow from "../../RelatedToolRow.astro";
import ResultSummary from "../shared/ResultSummary.astro";
import ToolPageFrame from "../shared/ToolPageFrame.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import type { CatalogToolId } from "../../../data/toolsCatalog";
import "../../../styles/tools/lunar-date-converter-v2.css";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.lunarDateConverter;
const faqSchema = buildFaqPageJsonLd(m.faq.items);

/** B1A temporary outbound Related Tools — canonical catalog integration deferred to Post-tool Link Integration Gate. */
const b1aRelatedToolIds = ["japanese-era-converter", "age-calculator"] as const satisfies readonly CatalogToolId[];

const toolCopy: Pick<
	Record<CatalogToolId, { title: string; relatedDescription: string }>,
	(typeof b1aRelatedToolIds)[number]
> = {
	"japanese-era-converter": messages.tools.japaneseEraConverter,
	"age-calculator": messages.tools.ageCalculator,
};

const relatedToolItems = b1aRelatedToolIds.map((id) => ({
	href: getLocalizedPath(locale, `/${id}/`),
	name: toolCopy[id].title,
	description: toolCopy[id].relatedDescription,
	icon: catalogIconMap[id],
}));

const rsPrimaryText = m.fixtureDefaultPrimary;
const rsPrimaryAria = rsPrimaryText.replace(/\n/g, "");
const rsPrimary = {
	text: rsPrimaryText,
	ariaLabel: rsPrimaryAria,
};

const modeSwitchIconHtml =
	'<svg class="tool-mode-switch-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 2.75v10.5M5 13.25 2.6 10.85M5 13.25l2.4-2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11 13.25V2.75M11 2.75 8.6 5.15M11 2.75l2.4 2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<div data-lunar-date-converter-v2 data-ldcv2-locale={locale === "zh" ? "zh" : "en"}>
	{/* Layout contract：blocking sync load，須在 ResultSummary 首次 paint 前可用 */}
	<script is:inline src="/scripts/lunar-date-converter-layout-contract.js?v=ldc1"></script>

	<ToolPageFrame
		locale={locale}
		relatedDrawerAriaLabel={m.relatedToolsDrawerAriaLabel}
		toggleRelatedToolsDrawerAriaLabel={m.toggleRelatedToolsDrawerAriaLabel}
		relatedHeading={m.relatedToolsHeading}
		mobileControlsAriaLabel={m.mobileControlsAriaLabel}
	>
		<Fragment slot="title">{m.kicker}</Fragment>

		<div slot="result" class="ldcv2-result-host">
			{/*
				Critical primary 字級：blocking inline，與 ResultSummary 同帧。
				避免 shared result-summary.css 先 paint 小字。
			*/}
			<style is:inline>
				/*
				  Lunar textual primary：語系分開調字級。
				  EN 壓低 desktop max，避免正常／較長干支無意義折行。
				  ZH 搭配 fixture \\n + tool-local pre-line，固定語意兩行。
				*/
				[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
					[data-result-summary][data-rs-content="textual"]
					.rs-value[data-rs-value="primary"] {
					white-space: pre-line;
				}
				[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
					[data-result-summary][data-rs-content="textual"],
				[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
				[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
					--rs-textual-primary-size: 3.75rem;
				}
				[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
					[data-result-summary][data-rs-content="textual"],
				[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
				[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
					--rs-textual-primary-size: 3.75rem;
				}
				@media (max-width: 767px) and (orientation: portrait) {
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: clamp(2.125rem, 9.5cqi, 2.5rem);
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: clamp(2.75rem, 13cqi, 3.5rem);
					}
				}
				@media (min-width: 900px) and (min-height: 700px) and (hover: hover) {
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
						[data-result-summary][data-rs-content="textual"]:is(
							[data-rs-layout="desktop"],
							[data-rs-layout="portrait"]
						) {
						--rs-textual-primary-size: clamp(3.25rem, 10.5cqi, 3.875rem);
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
						[data-result-summary][data-rs-content="textual"]:is(
							[data-rs-layout="desktop"],
							[data-rs-layout="portrait"]
						) {
						--rs-textual-primary-size: clamp(3.5rem, 12cqi, 4.5rem);
					}
				}
				@media (orientation: landscape) and (max-height: 700px) and (max-width: 1200px) {
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"] {
						--rs-textual-primary-size: 2.75rem;
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"] {
						--rs-textual-primary-size: 2.5rem;
					}
				}
			</style>

			<ResultSummary
				content="textual"
				layout="desktop"
				variant="spacious"
				ariaLabel={m.resultsLabel}
				primary={rsPrimary}
				weekday={m.fixtureDefaultWeekday}
				support={null}
				class="ldcv2-result-summary"
			/>
			<script is:inline>
				/* Layout bootstrap — sync before first paint；bind resize／orientation */
				(function () {
					var layout = window.TimivaLunarDateConverterLayout;
					layout?.applyLayoutAttrs(document);
					layout?.bindLayoutListeners?.();
				})();
			</script>
		</div>

		{/*
			Cluster 必須是 desktopControls slot 根節點。
			多包一層無寬度 wrapper 時，tpf-stage align-items:center
			會讓欄位縮成 content-driven（約 250px），吃不到 Standard 420。
		*/}
		<div
			slot="desktopControls"
			class="ldcv2-input-cluster ldcv2-input-cluster--desktop tool-standard-pill-field-cluster"
			aria-label={m.upperControlsAriaLabel}
		>
			<button type="button" class="tool-mode-switch">
				<Fragment set:html={modeSwitchIconHtml} />
				<span>{m.switchToLunarInput}</span>
			</button>
			<button type="button" class="tool-mode-switch" hidden>
				<Fragment set:html={modeSwitchIconHtml} />
				<span>{m.switchToGregorianInput}</span>
			</button>

			<div class="ldcv2-date-capsule" role="group" aria-label={m.dateLabel}>
				<div class="ldcv2-date-input-wrap">
					<input
						type="text"
						class="ldcv2-date-input"
						readonly
						value={m.fixtureDateValue}
						aria-label={m.dateInputAriaLabel}
						placeholder={m.dateInputPlaceholder}
					/>
				</div>
				<button
					type="button"
					class="ldcv2-calendar-toggle"
					aria-label={m.openCalendarAriaLabel}
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<rect x="3" y="5" width="18" height="16" rx="3"></rect>
						<path d="M8 3v4M16 3v4M7 11h10" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
		</div>

		<button
			slot="mobilePrimaryControl"
			type="button"
			class="preview-tool-control-btn tool-primary-entry-capsule ldcv2-mobile-capsule"
			disabled
			aria-label={m.primaryActionLabel}
		>
			{m.capsulePlaceholder}
		</button>

		<Fragment slot="drawerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerContent">
			<section class="pb-12" aria-labelledby="ldcv2-about-heading">
				<h2 id="ldcv2-about-heading" class="mb-2 text-lg font-semibold text-white">
					{m.about.heading}
				</h2>
				<p class="text-sm leading-relaxed text-slate-400">{m.about.body}</p>
			</section>

			<section class="pb-12" aria-labelledby="ldcv2-howto-heading">
				<h2 id="ldcv2-howto-heading" class="mb-2 text-lg font-semibold text-white">
					{m.howTo.heading}
				</h2>
				<ol class="list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-400">
					{m.howTo.steps.map((step) => <li>{step}</li>)}
				</ol>
			</section>

			<section class="pb-12" aria-labelledby="ldcv2-tags-heading">
				<h2 id="ldcv2-tags-heading" class="mb-4 text-lg font-semibold text-white">
					{m.commonUses.heading}
				</h2>
				<ul class="tool-keyword-list" role="list">
					{m.commonUses.items.map((item) => <li class="tool-keyword-chip">{item}</li>)}
				</ul>
			</section>

			<section aria-labelledby="ldcv2-faq-heading">
				<h2 id="ldcv2-faq-heading" class="mb-4 text-lg font-semibold text-white">
					{m.faq.heading}
				</h2>
				<div class="border-t border-white/20">
					{
						m.faq.items.map((item) => (
							<details class="group border-b border-white/20 py-4">
								<summary class="flex list-none items-center justify-between gap-4 font-medium text-white [&::-webkit-details-marker]:hidden">
									<span>{item.question}</span>
									<span class="relative flex h-4 w-4 shrink-0 items-center justify-center text-slate-400">
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 16 16"
											fill="none"
											class="h-4 w-4 group-open:hidden"
											aria-hidden="true"
										>
											<path
												d="M8 3.5v9M3.5 8h9"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"></path>
										</svg>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 16 16"
											fill="none"
											class="hidden h-4 w-4 group-open:block"
											aria-hidden="true"
										>
											<path
												d="M3.5 8h9"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"></path>
										</svg>
									</span>
								</summary>
								<p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
							</details>
						))
					}
				</div>
			</section>
		</Fragment>
	</ToolPageFrame>
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
	import { init as initResultSummary } from "../../../scripts/result-summary-controller.ts";

	initResultSummary();
</script>
