---
/**
 * Lunar Date Converter V2 — ToolPageFrame adopter.
 * B1A: lower content + temporary Related Tools wiring.
 * B1B: upper visual shell.
 * B2B: Desktop Gregorian ↔ Lunar interaction.
 */
import RelatedToolRow from "../../RelatedToolRow.astro";
import AdaptiveMobileEditor from "../shared/AdaptiveMobileEditor.astro";
import DesktopCalendar from "../shared/DesktopCalendar.astro";
import LunarCalendar from "./LunarCalendar.astro";
import ResultSummary from "../shared/ResultSummary.astro";
import ToolPageFrame from "../shared/ToolPageFrame.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import { getCatalogTool, type CatalogToolId } from "../../../data/toolsCatalog";
import "../../../styles/tools/adaptive-mobile-editor.css";
import "../../../styles/tools/lunar-date-converter-v2.css";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.lunarDateConverter;
const faqSchema = buildFaqPageJsonLd(m.faq.items);

/** Catalog-declared outbound only — no getRelatedTools featured padding. */
const lunarCatalog = getCatalogTool("lunar-date-converter");
const declaredRelatedIds = (lunarCatalog?.relatedIds ?? []) as CatalogToolId[];

const toolCopy: Record<
	CatalogToolId,
	{ title: string; relatedDescription: string }
> = {
	"event-countdown": messages.tools.eventCountdown,
	"date-range": messages.tools.dateRange,
	"countdown-timer": messages.tools.countdownTimer,
	"year-progress": messages.tools.yearProgress,
	"age-calculator": messages.tools.ageCalculator,
	"days-between-dates": messages.tools.daysBetweenDates,
	"business-days-calculator": messages.tools.businessDaysCalculator,
	"life-progress": messages.tools.lifeProgress,
	"date-calculator": messages.tools.dateCalculator,
	"hours-calculator": messages.tools.hoursCalculator,
	"japanese-era-converter": messages.tools.japaneseEraConverter,
	"lunar-date-converter": messages.tools.lunarDateConverter,
};

const relatedToolItems = declaredRelatedIds
	.map((id) => getCatalogTool(id))
	.filter((tool): tool is NonNullable<typeof tool> => Boolean(tool?.available))
	.map((tool) => ({
		href: getLocalizedPath(locale, `/${tool.slug}/`),
		name: toolCopy[tool.id].title,
		description: toolCopy[tool.id].relatedDescription,
		icon: catalogIconMap[tool.id],
	}));

const rsPrimaryText = locale === "zh" ? "…" : "…";
const rsPrimary = {
	text: rsPrimaryText,
	ariaLabel: rsPrimaryText,
};

const modeSwitchIconHtml =
	'<svg class="tool-mode-switch-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 2.75v10.5M5 13.25 2.6 10.85M5 13.25l2.4-2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11 13.25V2.75M11 2.75 8.6 5.15M11 2.75l2.4 2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<div
	data-lunar-date-converter-v2
	data-ldcv2-locale={locale === "zh" ? "zh" : "en"}
	data-ldcv2-input-mode="gregorian"
	data-ldcv2-field-phase="committed-valid"
	data-ldcv2-gregorian-placeholder={m.dateInputPlaceholder}
	data-ldcv2-lunar-placeholder={m.lunarInputPlaceholder}
	data-ldcv2-gregorian-aria={m.dateInputAriaLabel}
	data-ldcv2-lunar-aria={m.lunarInputAriaLabel}
	data-ldcv2-copy-reset={m.resetLabel}
	data-ldcv2-copy-error-unrecognized={m.errorUnrecognizedFormat}
	data-ldcv2-copy-error-out-of-range={m.errorOutOfRange}
	data-ldcv2-copy-error-invalid-date={m.errorInvalidDate}
	data-ldcv2-copy-error-invalid-leap={m.errorInvalidLeapMonth}
	data-ldcv2-copy-error-invalid-day={m.errorInvalidLunarDay}
	data-ldcv2-copy-error-unsupported-leap-typo={m.errorUnsupportedLeapTypo}
	data-ldcv2-copy-error-incomplete={m.errorIncompleteDate}
>
	<script is:inline src="/scripts/lunar-date-converter-layout-contract.js?v=ldc4"></script>

	<ToolPageFrame
		locale={locale}
		relatedDrawerAriaLabel={m.relatedToolsDrawerAriaLabel}
		toggleRelatedToolsDrawerAriaLabel={m.toggleRelatedToolsDrawerAriaLabel}
		relatedHeading={m.relatedToolsHeading}
		mobileControlsAriaLabel={m.mobileControlsAriaLabel}
	>
		<Fragment slot="title">{m.kicker}</Fragment>

		<div slot="result" class="ldcv2-result-host">
			<style is:inline>
				[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
					[data-result-summary][data-rs-content="textual"]
					.rs-value[data-rs-value="primary"] {
					white-space: pre-line;
				}
				@media (min-width: 768px) and (hover: hover) {
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"]
						.rs-value[data-rs-value="primary"] {
						white-space: nowrap;
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"]
						.rs-value[data-rs-value="primary"] {
						white-space: nowrap;
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"] {
						--rs-textual-primary-size: 4.5rem;
					}
					[data-lunar-date-converter-v2][data-ldcv2-rs-composition="wide"][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"]
						.rs-value[data-rs-value="primary"] {
						white-space: nowrap;
					}
					[data-lunar-date-converter-v2][data-ldcv2-rs-composition="constrained"][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"] {
						width: 100%;
						max-width: 100%;
					}
					[data-lunar-date-converter-v2][data-ldcv2-rs-composition="constrained"][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"]
						.rs-primary {
						width: 100%;
						max-width: 100%;
					}
					[data-lunar-date-converter-v2][data-ldcv2-rs-composition="constrained"][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"]
						.rs-value[data-rs-value="primary"] {
						white-space: pre-line;
					}
				}
				[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
					[data-result-summary][data-rs-content="textual"],
				[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"],
				[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
					[data-result-summary][data-rs-content="textual"],
				[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
					[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"] {
					--rs-textual-primary-size: 3.75rem;
				}
				@media (max-width: 767px) {
					[data-lunar-date-converter-v2] .ldcv2-result-host {
						padding-inline: 1.25rem;
						box-sizing: border-box;
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"]
						.rs-value[data-rs-value="primary"] {
						white-space: nowrap;
						max-width: 100%;
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"]
						.rs-value[data-rs-value="primary"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"]
						.rs-value[data-rs-value="primary"] {
						white-space: pre;
						max-width: 100%;
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: clamp(2.75rem, 18cqi, 4rem);
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: clamp(3.125rem, 18cqi, 4.125rem);
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: 4.125rem;
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: 3.5rem;
					}
					[data-lunar-date-converter-v2][data-ldcv2-rs-portrait-fit][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"],
					[data-lunar-date-converter-v2][data-ldcv2-rs-portrait-fit][data-ldcv2-locale="zh"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="portrait"] {
						--rs-textual-primary-size: var(--ldcv2-rs-portrait-fit-size);
					}
				}
				@media (min-width: 900px) and (min-height: 700px) and (hover: hover) {
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="lunar"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"] {
						--rs-textual-primary-size: clamp(4.25rem, 13cqi, 5rem);
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"][data-ldcv2-input-mode="gregorian"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="desktop"] {
						--rs-textual-primary-size: clamp(3.25rem, 10.5cqi, 3.875rem);
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
						[data-result-summary][data-rs-content="textual"]:is(
							[data-rs-layout="desktop"],
							[data-rs-layout="portrait"]
						) {
						--rs-textual-primary-size: clamp(3.5rem, 12cqi, 4.5rem);
					}
				}
				@media (orientation: landscape) and (max-height: 700px) and (max-width: 1200px) and (hover: none) {
					[data-lunar-date-converter-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"] {
						display: flex;
						flex-direction: column;
						align-items: center;
						justify-content: center;
						width: 100%;
						max-width: 100%;
						margin-inline: auto;
						--rs-textual-weekday-size: clamp(0.9375rem, 2.8vw, 1.125rem);
					}
					[data-lunar-date-converter-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"]
						.rs-primary {
						grid-area: unset;
						width: 100%;
						max-width: 100%;
						min-width: 0;
					}
					[data-lunar-date-converter-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"]
						.rs-value[data-rs-value="primary"] {
						white-space: nowrap;
						max-width: 100%;
					}
					[data-lunar-date-converter-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"]
						.rs-weekday {
						grid-area: unset;
						margin-top: 0.375rem;
						width: 100%;
						text-align: center;
					}
					[data-lunar-date-converter-v2]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"]
						.rs-support {
						grid-area: unset;
						margin-top: 0.5rem;
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="en"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"] {
						--rs-textual-primary-size: clamp(2.25rem, 10cqi, 3.75rem);
					}
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
						[data-result-summary][data-rs-content="textual"],
					[data-lunar-date-converter-v2][data-ldcv2-locale="zh"]
						[data-result-summary][data-rs-content="textual"][data-rs-layout="landscape"] {
						--rs-textual-primary-size: clamp(2rem, 9cqi, 3.375rem);
					}
				}
			</style>

			<ResultSummary
				content="textual"
				layout="desktop"
				variant="spacious"
				ariaLabel={m.resultsLabel}
				primary={rsPrimary}
				weekday={null}
				support={null}
				class="ldcv2-result-summary"
			/>
			<script is:inline>
				(function () {
					var layout = window.TimivaLunarDateConverterLayout;
					layout?.applyLayoutAttrs(document);
					layout?.bindLayoutListeners?.();
				})();
			</script>
		</div>

		<div
			slot="desktopControls"
			class="ldcv2-input-cluster ldcv2-input-cluster--desktop tool-standard-pill-field-cluster"
			aria-label={m.upperControlsAriaLabel}
		>
			<button type="button" class="tool-mode-switch" data-ldcv2-switch="lunar">
				<Fragment set:html={modeSwitchIconHtml} />
				<span>{m.switchToLunarInput}</span>
			</button>
			<button type="button" class="tool-mode-switch" data-ldcv2-switch="gregorian" hidden>
				<Fragment set:html={modeSwitchIconHtml} />
				<span>{m.switchToGregorianInput}</span>
			</button>

			<div class="ldcv2-date-capsule" data-ldcv2-date-capsule role="group" aria-label={m.dateLabel}>
				<div class="ldcv2-date-input-wrap">
					<div class="ldcv2-date-inline">
						<input
							type="text"
							class="ldcv2-date-input"
							data-ldcv2-date-input
							inputmode="numeric"
							autocomplete="off"
							spellcheck="false"
							value=""
							aria-label={m.dateInputAriaLabel}
							placeholder={m.dateInputPlaceholder}
							aria-invalid="false"
						/>
						<span
							class="ldcv2-inline-error"
							id="ldcv2-field-error"
							data-ldcv2-field-error-wrap
							hidden
							role="status"
						>
							<span data-ldcv2-field-error-text></span>
							<span class="ldcv2-inline-error-mark" data-ldcv2-field-invalid aria-hidden="true">
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path fill="currentColor" d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
									<path
										fill="#0f172a"
										d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
									></path>
								</svg>
							</span>
						</span>
					</div>
				</div>
				<button
					type="button"
					class="ldcv2-calendar-toggle"
					data-ldcv2-calendar-toggle
					aria-haspopup="dialog"
					aria-expanded="false"
					aria-controls="ldc-sdc"
					aria-label={m.openCalendarAriaLabel}
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<rect x="3" y="5" width="18" height="16" rx="3"></rect>
						<path d="M8 3v4M16 3v4M7 11h10" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>

			<button type="button" class="ldcv2-reset" data-ldcv2-reset tabindex="-1">
				{m.resetLabel}
			</button>
		</div>

		<button
			slot="mobilePrimaryControl"
			type="button"
			class="preview-tool-control-btn tool-primary-entry-capsule ldcv2-mobile-capsule"
			data-ldcv2-sheet-trigger
			aria-label={m.primaryActionLabel}
		>
			{m.capsulePlaceholder}
		</button>

		<AdaptiveMobileEditor
			slot="ame"
			id="ldcv2-ame"
			ariaLabel={m.sheetAriaLabel}
			title={m.sheetTitle}
		>
			<div slot="content" class="ldcv2-ame-form" data-ldcv2-ame-form>
				<div class="ldcv2-ame-panel" data-ldcv2-ame-gregorian>
					<div
						class="ldcv2-ame-picker"
						data-ldcv2-ame-picker="gregorian"
						role="group"
						aria-label={m.ameGregorianLabel}
					>
						<label class="ame-setting-row ame-setting-row--select ldcv2-ame-picker-row">
							<span class="ame-setting-label">{m.amePickerYear}</span>
							<span class="ame-setting-control">
								<select
									class="ame-native-control"
									data-ldcv2-ame-g-year
									aria-label={m.amePickerYear}
								>
								</select>
							</span>
						</label>
						<label class="ame-setting-row ame-setting-row--select ldcv2-ame-picker-row">
							<span class="ame-setting-label">{m.amePickerMonth}</span>
							<span class="ame-setting-control">
								<select
									class="ame-native-control"
									data-ldcv2-ame-g-month
									aria-label={m.amePickerMonth}
								>
								</select>
							</span>
						</label>
						<label class="ame-setting-row ame-setting-row--select ldcv2-ame-picker-row">
							<span class="ame-setting-label">{m.amePickerDay}</span>
							<span class="ame-setting-control">
								<select
									class="ame-native-control"
									data-ldcv2-ame-g-day
									aria-label={m.amePickerDay}
								>
								</select>
							</span>
						</label>
					</div>
					<button
						type="button"
						class="tool-mode-switch ldcv2-mode-switch"
						data-ldcv2-ame-switch="lunar"
					>
						<Fragment set:html={modeSwitchIconHtml} />
						<span>{m.ameSwitchToLunar}</span>
					</button>
				</div>

				<div class="ldcv2-ame-panel" data-ldcv2-ame-lunar hidden>
					<div
						class="ldcv2-ame-picker"
						data-ldcv2-ame-picker="lunar"
						role="group"
						aria-label={m.ameLunarLabel}
					>
						<label class="ame-setting-row ame-setting-row--select ldcv2-ame-picker-row">
							<span class="ame-setting-label">{m.amePickerYear}</span>
							<span class="ame-setting-control">
								<select
									class="ame-native-control"
									data-ldcv2-ame-l-year
									aria-label={m.amePickerYear}
								>
								</select>
							</span>
						</label>
						<label class="ame-setting-row ame-setting-row--select ldcv2-ame-picker-row">
							<span class="ame-setting-label">{m.amePickerMonth}</span>
							<span class="ame-setting-control">
								<select
									class="ame-native-control"
									data-ldcv2-ame-l-month
									aria-label={m.amePickerMonth}
								>
								</select>
							</span>
						</label>
						<label class="ame-setting-row ame-setting-row--select ldcv2-ame-picker-row">
							<span class="ame-setting-label">{m.amePickerDay}</span>
							<span class="ame-setting-control">
								<select
									class="ame-native-control"
									data-ldcv2-ame-l-day
									aria-label={m.amePickerDay}
								>
								</select>
							</span>
						</label>
					</div>
					<button
						type="button"
						class="tool-mode-switch ldcv2-mode-switch"
						data-ldcv2-ame-switch="gregorian"
					>
						<Fragment set:html={modeSwitchIconHtml} />
						<span>{m.ameSwitchToGregorian}</span>
					</button>
				</div>
			</div>
		</AdaptiveMobileEditor>

		<Fragment slot="drawerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerRelated">
			{
				relatedToolItems.map((tool) => (
					<RelatedToolRow
						href={tool.href}
						name={tool.name}
						description={tool.description}
						icon={tool.icon}
					/>
				))
			}
		</Fragment>

		<Fragment slot="lowerContent">
