---
import RelatedToolRow from "../../RelatedToolRow.astro";
import ToolAdSlot from "../../ToolAdSlot.astro";
import ToolCard from "../../ToolCard.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getCatalogTool, type CatalogToolId } from "../../../data/toolsCatalog";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import "../../../styles/tools/tool-mobile-sheet-v2-baseline.css";

interface Props {
	locale?: Locale;
}

const AGE_CALCULATOR_OUTBOUND_IDS = [
	"date-range",
	"event-countdown",
	"year-progress",
] as const satisfies readonly CatalogToolId[];

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.ageCalculator;

const toolCopy: Record<
	CatalogToolId,
	{ title: string; relatedDescription: string }
> = {
	"event-countdown": messages.tools.eventCountdown,
	"date-range": messages.tools.dateRange,
	"countdown-timer": messages.tools.countdownTimer,
	"year-progress": messages.tools.yearProgress,
	"age-calculator": messages.tools.ageCalculator,
	"life-progress": messages.tools.lifeProgress,
};

const relatedToolItems = AGE_CALCULATOR_OUTBOUND_IDS.map((id) => {
	const tool = getCatalogTool(id);

	if (!tool?.available) {
		return null;
	}

	return {
		href: getLocalizedPath(locale, `/${tool.slug}/`),
		name: toolCopy[tool.id].title,
		description: toolCopy[tool.id].relatedDescription,
		icon: catalogIconMap[tool.id],
	};
}).filter((item): item is NonNullable<typeof item> => item !== null);

const faqSchema = buildFaqPageJsonLd(m.faq.items);

const clientI18n = {
	locale,
	intlLocale: locale === "zh" ? "zh-TW" : "en-US",
	primaryResultUnit: m.primaryResultUnit,
	exactAgeZero: m.exactAgeZero,
	daysLivedZero: m.daysLivedZero,
	exactAgeTemplate: m.exactAgeTemplate,
	daysLivedTemplate: m.daysLivedTemplate,
	invalidBirthDate: m.invalidBirthDate,
	invalidAsOfDate: m.invalidAsOfDate,
	birthDatePlaceholder: m.birthDatePlaceholder,
	birthDateDesktopPlaceholder: m.birthDateDesktopPlaceholder,
	calendarLabel: m.calendarLabel,
	openCalendarAriaLabel: m.openCalendarAriaLabel,
	asOfToday: m.asOfToday,
	asOfTemplate: m.asOfTemplate,
	asOfCalendarLabel: m.asOfCalendarLabel,
	openAsOfCalendarAriaLabel: m.openAsOfCalendarAriaLabel,
	backToTodayAriaLabel: m.backToTodayAriaLabel,
	previousMonth: m.previousMonth,
	nextMonth: m.nextMonth,
	weekdays: m.weekdays,
};
---

<div data-age-calculator-v2 data-acv2-client-i18n={JSON.stringify(clientI18n)}>
	<section data-acv2-main-tool class="preview-tool-main-section px-6">
		<div class="preview-tool-first-screen">
			<div class="preview-tool-stage tool-stage mx-auto w-full max-w-md md:max-w-lg">
				<div class="preview-tool-result-group text-center">
					<h1
						class="acv2-tool-name preview-tool-landscape-compact-title text-sm font-medium tracking-normal text-slate-300 md:text-base"
					>
						{m.kicker}
					</h1>

					<div class="preview-tool-result-block mt-6 md:mt-8">
						<p
							class="preview-tool-result-number leading-none font-normal tracking-tight tabular-nums"
							data-acv2-result-years
							aria-label={`0 ${m.primaryResultUnit}`}
						>
							0
						</p>
						<p class="preview-tool-result-label text-xs text-slate-400 md:text-sm">
							{m.primaryResultUnit}
						</p>

						<span class="acv2-result-divider" aria-hidden="true"></span>

						<div class="acv2-secondary-results" aria-hidden="true">
							<p class="acv2-secondary-line acv2-secondary-line--stacked" data-acv2-exact-age-stacked>
								{m.exactAgeZero}
							</p>
							<p class="acv2-secondary-line acv2-secondary-line--stacked" data-acv2-days-lived-stacked>
								{m.daysLivedZero}
							</p>
							<p class="acv2-secondary-line acv2-secondary-line--landscape" data-acv2-exact-age-landscape>
								{m.exactAgeZero} / {m.daysLivedZero}
							</p>
						</div>
					</div>
				</div>

				<div class="acv2-input-cluster acv2-input-cluster--desktop" aria-label={m.upperControlsAriaLabel}>
					<div class="acv2-birth-capsule-wrap">
						<div
							class="acv2-birth-capsule"
							role="group"
							aria-label={m.birthDateLabel}
							data-acv2-birth-capsule
						>
							<div class="acv2-birth-input-wrap">
								<div class="acv2-birth-date-inline">
									<input
										type="text"
										class="acv2-birth-input"
										data-acv2-birth-input
										inputmode="numeric"
										autocomplete="bday"
										spellcheck="false"
										aria-label={m.birthDateLabel}
										placeholder={m.birthDateDesktopPlaceholder}
									/>
									<span
										class="acv2-date-invalid-icon"
										data-acv2-desktop-invalid-icon
										hidden
										aria-label={m.invalidBirthDate}
									>
										<svg viewBox="0 0 16 16" aria-hidden="true">
											<path
												fill="currentColor"
												d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
											<path
												fill="#0f172a"
												d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
											></path>
										</svg>
									</span>
								</div>
							</div>
							<button
								type="button"
								class="acv2-birth-capsule__icon"
								data-acv2-calendar-toggle
								aria-expanded="false"
								aria-controls="acv2-calendar-popover"
								aria-label={m.openCalendarAriaLabel}
							>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<rect x="3" y="5" width="18" height="16" rx="3"></rect>
									<path d="M8 3v4M16 3v4M7 11h10" stroke-linecap="round"></path>
								</svg>
							</button>
						</div>
					</div>

					<div class="acv2-asof-row" data-acv2-asof>
						<button
							type="button"
							class="acv2-asof-control"
							data-acv2-asof-control
							aria-expanded="false"
							aria-controls="acv2-asof-calendar-popover"
							aria-label={m.openAsOfCalendarAriaLabel}
						>
							<span data-acv2-asof-label>{m.asOfToday}</span>
						</button>
						<button
							type="button"
							class="acv2-asof-reset"
							data-acv2-asof-reset
							hidden
							aria-label={m.backToTodayAriaLabel}
						>
							<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path
									d="M4.5 6.5H11a2.5 2.5 0 1 1 0 5H9"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
								<path
									d="M6.5 4.5 4.5 6.5 6.5 8.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
						<span
							class="acv2-date-invalid-icon acv2-asof-invalid-icon"
							data-acv2-asof-invalid-icon
							hidden
							aria-label={m.invalidAsOfDate}
						>
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path
									fill="currentColor"
									d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
								<path
									fill="#0f172a"
									d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
								></path>
							</svg>
						</span>
					</div>
				</div>

				<div
					class="preview-tool-controls acv2-mobile-controls flex flex-wrap justify-center gap-3 md:gap-4"
					aria-label={m.upperControlsAriaLabel}
				>
					<button
						type="button"
						class="preview-tool-control-btn acv2-mobile-control-btn inline-flex min-h-10 items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 backdrop-blur-sm md:min-h-11 md:px-5 md:py-2.5"
						data-acv2-sheet-open
					>
						{m.startChoosingBirthday}
					</button>
				</div>
			</div>
		</div>
	</section>

	<aside
		data-acv2-drawer
		data-open="true"
		aria-label={m.relatedToolsDrawerAriaLabel}
		class="pointer-events-none fixed inset-y-0 right-0 z-20 hidden xl:block"
	>
		<span class="hidden translate-x-[300px]" aria-hidden="true"></span>
		<div
			data-acv2-drawer-shell
			data-open="true"
			class="preview-tool-drawer-frosted pointer-events-auto relative flex h-dvh rounded-tl-3xl rounded-bl-3xl border-l border-white/10 shadow-2xl shadow-black/25 ring-1 ring-inset ring-white/[0.04] transition-transform duration-200 ease-out"
		>
			<button
				type="button"
				data-acv2-drawer-toggle
				aria-expanded="true"
				class="relative z-10 flex w-14 shrink-0 items-center justify-center self-stretch text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
				aria-label={m.toggleRelatedToolsDrawerAriaLabel}
			>
				<svg
					data-drawer-arrow-open
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="h-7 w-7"
					aria-hidden="true"
				>
					<path
						d="M10 3L5 8l5 5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				<svg
					data-drawer-arrow-closed
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="hidden h-7 w-7"
					aria-hidden="true"
				>
					<path
						d="M6 3l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>

			<div data-acv2-drawer-panel class="relative z-10 flex h-full w-[300px] shrink-0 flex-col">
				<div class="px-5 pb-3 pt-5">
					<h2 class="text-lg font-semibold text-white">{messages.relatedTools.heading}</h2>
				</div>
				<ToolAdSlot variant="sidebar" locale={locale} state="is-disabled" />
				<div class="flex-1 space-y-3 overflow-y-auto px-5 pb-5">
					{
						relatedToolItems.map((tool) => (
							<div>
								<ToolCard
									href={tool.href}
									name={tool.name}
									description={tool.description}
									icon={tool.icon}
								/>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</aside>

	<div
		class="tool-lower-content mx-auto max-w-3xl px-6 pb-20 text-left"
		data-acv2-lower-content
	>
		<ToolAdSlot variant="main" locale={locale} state="is-disabled" />

		<section
			data-acv2-related-tools
			class="pb-12 xl:hidden"
			aria-labelledby="acv2-related-heading"
		>
			<h2 id="acv2-related-heading" class="mb-4 text-lg font-semibold text-white">
				{messages.relatedTools.heading}
			</h2>
			<div class="space-y-3">
				{
					relatedToolItems.map((tool) => (
						<RelatedToolRow
							href={tool.href}
							name={tool.name}
							description={tool.description}
							icon={tool.icon}
						/>
					))
				}
			</div>
		</section>

		<section class="pb-12" aria-labelledby="acv2-about-heading">
			<h2 id="acv2-about-heading" class="mb-2 text-lg font-semibold text-white">
				{m.about.heading}
			</h2>
			<p class="text-sm leading-relaxed text-slate-400">{m.about.body}</p>
		</section>

		<section class="pb-12" aria-labelledby="acv2-howto-heading">
			<h2 id="acv2-howto-heading" class="mb-2 text-lg font-semibold text-white">
				{m.howTo.heading}
			</h2>
			<ol class="list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-400">
				{m.howTo.steps.map((step) => <li>{step}</li>)}
			</ol>
		</section>

		<section class="pb-12" aria-labelledby="acv2-uses-heading">
			<h2 id="acv2-uses-heading" class="mb-4 text-lg font-semibold text-white">
				{m.commonUses.heading}
			</h2>
			<ul class="acv2-keyword-list" role="list">
				{m.commonUses.items.map((item) => <li class="acv2-keyword-chip">{item}</li>)}
			</ul>
		</section>

		<section aria-labelledby="acv2-faq-heading">
			<h2 id="acv2-faq-heading" class="mb-4 text-lg font-semibold text-white">
				{m.faq.heading}
			</h2>
			<div class="border-t border-white/20">
				{
					m.faq.items.map((item) => (
						<details class="group border-b border-white/20 py-4">
							<summary
								class="flex list-none items-center justify-between gap-4 font-medium text-white [&::-webkit-details-marker]:hidden"
							>
								<span>{item.question}</span>
								<span class="relative flex h-4 w-4 shrink-0 items-center justify-center text-slate-400">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 16 16"
										fill="none"
										class="h-4 w-4 group-open:hidden"
										aria-hidden="true"
									>
										<path
											d="M8 3.5v9M3.5 8h9"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"></path>
									</svg>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 16 16"
										fill="none"
										class="hidden h-4 w-4 group-open:block"
										aria-hidden="true"
									>
										<path
											d="M3.5 8h9"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"></path>
									</svg>
								</span>
							</summary>
							<p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
						</details>
					))
				}
			</div>
		</section>
	</div>

	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	{/* Desktop calendar popover — fixed，對齊結果區右側；不掛在 input 下方 */}
	<div
		id="acv2-calendar-popover"
		class="acv2-calendar-popover"
		data-acv2-calendar-popover
		role="dialog"
		aria-label={m.calendarLabel}
		aria-hidden="true"
		hidden
	>
		<div class="calendar-panel calendar-card acv2-calendar-panel">
			<div class="calendar-toolbar">
				<button
					type="button"
					class="calendar-nav-btn"
					data-acv2-calendar-prev
					aria-label={m.previousMonth}
				>
					‹
				</button>
				<div class="acv2-calendar-selects">
					<label class="acv2-calendar-select-wrap">
						<span class="sr-only">{m.monthFieldLabel}</span>
						<select
							class="acv2-calendar-select"
							data-acv2-calendar-month-select
							aria-label={m.monthFieldLabel}
						>
						</select>
					</label>
					<label class="acv2-calendar-select-wrap">
						<span class="sr-only">{m.yearFieldLabel}</span>
						<select
							class="acv2-calendar-select"
							data-acv2-calendar-year-select
							aria-label={m.yearFieldLabel}
						>
						</select>
					</label>
				</div>
				<button
					type="button"
					class="calendar-nav-btn"
					data-acv2-calendar-next
					aria-label={m.nextMonth}
				>
					›
				</button>
			</div>

			<div class="calendar-weekdays" aria-hidden="true">
				{m.weekdays.map((day) => <span>{day}</span>)}
			</div>

			<div class="calendar-grid" data-acv2-calendar-grid></div>
		</div>
	</div>

	{/* Desktop as-of calendar popover — 與 birth calendar 同一套視覺 */}
	<div
		id="acv2-asof-calendar-popover"
		class="acv2-calendar-popover"
		data-acv2-asof-calendar-popover
		role="dialog"
		aria-label={m.asOfCalendarLabel}
		aria-hidden="true"
		hidden
	>
		<div class="calendar-panel calendar-card acv2-calendar-panel">
			<div class="calendar-toolbar">
				<button
					type="button"
					class="calendar-nav-btn"
					data-acv2-asof-calendar-prev
					aria-label={m.previousMonth}
				>
					‹
				</button>
				<div class="acv2-calendar-selects">
					<label class="acv2-calendar-select-wrap">
						<span class="sr-only">{m.monthFieldLabel}</span>
						<select
							class="acv2-calendar-select"
							data-acv2-asof-calendar-month-select
							aria-label={m.monthFieldLabel}
						>
						</select>
					</label>
					<label class="acv2-calendar-select-wrap">
						<span class="sr-only">{m.yearFieldLabel}</span>
						<select
							class="acv2-calendar-select"
							data-acv2-asof-calendar-year-select
							aria-label={m.yearFieldLabel}
						>
						</select>
					</label>
				</div>
				<button
					type="button"
					class="calendar-nav-btn"
					data-acv2-asof-calendar-next
					aria-label={m.nextMonth}
				>
					›
				</button>
			</div>

			<div class="calendar-weekdays" aria-hidden="true">
				{m.weekdays.map((day) => <span>{day}</span>)}
			</div>

			<div class="calendar-grid" data-acv2-asof-calendar-grid></div>
		</div>
	</div>
</div>

<div data-acv2-sheet-portal data-mobile-sheet-baseline hidden aria-hidden="true">
	<div
		class="tool-operation-overlay"
		data-acv2-sheet-overlay
		data-tool-operation-overlay
		hidden
		aria-hidden="true"
	>
	</div>

	<div
		class="msb-sheet acv2-sheet"
		data-acv2-sheet
		role="dialog"
		aria-modal="true"
		aria-label={m.sheetAriaLabel}
		aria-hidden="true"
		inert
	>
		<div class="msb-sheet-handle" aria-hidden="true"></div>

		<div class="msb-sheet-body">
			<div class="msb-sheet-fields acv2-sheet-fields">
				{/* 第一列：套用 shared msb 三欄 input shell（對齊 Countdown） */}
				<div
					class="msb-sheet-fields--cols-3 acv2-sheet-ymd-row"
					data-acv2-sheet-ymd
					role="group"
					aria-label={m.birthDateLabel}
				>
					<label class="msb-field" data-acv2-sheet-year-field>
						<span class="msb-input-shell">
							<span class="msb-input-prefix">{m.yearFieldLabel}</span>
							<input
								id="acv2-sheet-year-input"
								type="text"
								class="msb-input"
								data-acv2-sheet-year-input
								inputmode="numeric"
								pattern="[0-9]*"
								autocomplete="bday-year"
								spellcheck="false"
								maxlength="4"
								aria-label={m.yearFieldLabel}
								placeholder={m.yearPlaceholder}
							/>
							<span
								class="acv2-date-invalid-icon acv2-sheet-ymd-invalid"
								data-acv2-sheet-year-invalid
								hidden
								aria-label={m.invalidBirthDate}
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
									<path
										fill="#0f172a"
										d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
									></path>
								</svg>
							</span>
						</span>
					</label>

					<label class="msb-field" data-acv2-sheet-month-field>
						<span class="msb-input-shell">
							<span class="msb-input-prefix">{m.monthFieldLabel}</span>
							<input
								id="acv2-sheet-month-input"
								type="text"
								class="msb-input"
								data-acv2-sheet-month-input
								inputmode="numeric"
								pattern="[0-9]*"
								autocomplete="bday-month"
								spellcheck="false"
								maxlength="2"
								aria-label={m.monthFieldLabel}
								placeholder={m.monthPlaceholder}
							/>
							<span
								class="acv2-date-invalid-icon acv2-sheet-ymd-invalid"
								data-acv2-sheet-month-invalid
								hidden
								aria-label={m.invalidBirthDate}
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
									<path
										fill="#0f172a"
										d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
									></path>
								</svg>
							</span>
						</span>
					</label>

					<label class="msb-field" data-acv2-sheet-day-field>
						<span class="msb-input-shell">
							<span class="msb-input-prefix">{m.dayFieldLabel}</span>
							<input
								id="acv2-sheet-day-input"
								type="text"
								class="msb-input"
								data-acv2-sheet-day-input
								inputmode="numeric"
								pattern="[0-9]*"
								autocomplete="bday-day"
								spellcheck="false"
								maxlength="2"
								aria-label={m.dayFieldLabel}
								placeholder={m.dayPlaceholder}
							/>
							<span
								class="acv2-date-invalid-icon acv2-sheet-ymd-invalid"
								data-acv2-sheet-day-invalid
								hidden
								aria-label={m.invalidBirthDate}
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
									<path
										fill="#0f172a"
										d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
									></path>
								</svg>
							</span>
						</span>
					</label>
				</div>

				<div class="acv2-sheet-asof-text" data-acv2-sheet-asof>
					<button
						type="button"
						class="acv2-sheet-asof-control"
						data-acv2-sheet-asof-control
					>
						<span data-acv2-sheet-asof-label>{m.asOfToday}</span>
					</button>
					<span
						class="acv2-date-invalid-icon acv2-sheet-asof-invalid"
						data-acv2-sheet-asof-invalid
						hidden
						aria-label={m.invalidAsOfDate}
					>
						<svg viewBox="0 0 16 16" aria-hidden="true">
							<path
								fill="currentColor"
								d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
							<path
								fill="#0f172a"
								d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
							></path>
						</svg>
					</span>
				</div>
				{/* Mobile 原生 date picker — 視覺隱藏，由 As-of 文字觸發；清除／重置回 today */}
				<input
					type="date"
					class="acv2-sheet-asof-native"
					data-acv2-sheet-asof-native
					min="1900-01-01"
					tabindex="-1"
					aria-hidden="true"
				/>
			</div>
		</div>
	</div>
</div>

