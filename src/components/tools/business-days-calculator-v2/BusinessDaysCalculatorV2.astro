---
import RelatedToolRow from "../../RelatedToolRow.astro";
import ToolAdSlot from "../../ToolAdSlot.astro";
import ToolCard from "../../ToolCard.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import { buildFaqPageJsonLd } from "../../../lib/buildFaqPageJsonLd";
import { getRelatedTools, type CatalogToolId } from "../../../data/toolsCatalog";
import { getLocalizedPath, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import "../../../styles/tools/tool-mobile-sheet-v2-baseline.css";
/* Tool-local styles load after shared MSB baseline */
import "../../../styles/tools/business-days-calculator-v2.css";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const messages = getMessages(locale);
const m = messages.businessDaysCalculator;
const relatedTools = getRelatedTools("business-days-calculator");

const toolCopy: Record<
	CatalogToolId,
	{ title: string; relatedDescription: string }
> = {
	"event-countdown": messages.tools.eventCountdown,
	"date-range": messages.tools.dateRange,
	"countdown-timer": messages.tools.countdownTimer,
	"year-progress": messages.tools.yearProgress,
	"age-calculator": messages.tools.ageCalculator,
	"days-between-dates": messages.tools.daysBetweenDates,
	"business-days-calculator": messages.tools.businessDaysCalculator,
	"life-progress": messages.tools.lifeProgress,
};

const relatedToolItems = relatedTools.map((tool) => ({
	href: getLocalizedPath(locale, `/${tool.slug}/`),
	name: toolCopy[tool.id].title,
	description: toolCopy[tool.id].relatedDescription,
	icon: catalogIconMap[tool.id],
}));

const faqSchema = buildFaqPageJsonLd(m.faq.items);

/* B2A：invalid icon aria label */
const invalidDateMessage =
	locale === "zh"
		? "請輸入 1900–2100 之間的有效日期"
		: "Enter a valid date between 1900 and 2100";
---

<div data-business-days-calculator-v2 data-bdcv2-result-digits="1-3" data-bdcv2-result-locale={locale === "zh" ? "zh" : "en"}>
	{/* B1B：第一屏結果 + Desktop 區間框 + AC 式日曆鈕 + Mobile Sheet 入口 */}
	<section data-bdcv2-main-tool class="preview-tool-main-section px-6">
		<div class="preview-tool-first-screen">
			<div class="preview-tool-stage tool-stage mx-auto w-full max-w-md md:max-w-lg">
				<div class="preview-tool-result-group text-center">
					<h1
						class="bdcv2-tool-name preview-tool-landscape-compact-title text-sm font-medium tracking-normal text-slate-300 md:text-base"
					>
						{m.kicker}
					</h1>

					<div class="preview-tool-result-block mt-6 md:mt-8">
						<div class="bdcv2-result-main">
							<p
								class="preview-tool-result-number leading-none font-normal tracking-tight tabular-nums"
								data-bdcv2-result-days
								aria-label={`0 ${m.primaryResultUnit}`}
							>
								0
							</p>
							<p
								class="preview-tool-result-label text-xs text-slate-400 md:text-sm"
								data-bdcv2-result-unit
							>
								{m.primaryResultUnit}
							</p>
						</div>

						<div class="bdcv2-result-secondary">
							<div class="bdcv2-result-secondary-item">
								<div class="bdcv2-result-secondary-number" data-bdcv2-result-total-days>0</div>
								<div class="preview-tool-result-label bdcv2-result-secondary-label text-xs text-slate-400/85 md:text-sm">
									{m.totalDaysLabel}
								</div>
							</div>
							<div class="bdcv2-result-secondary-item">
								<div class="bdcv2-result-secondary-number" data-bdcv2-result-weekend-days>0</div>
								<div class="preview-tool-result-label bdcv2-result-secondary-label text-xs text-slate-400/85 md:text-sm">
									{m.weekendDaysLabel}
								</div>
							</div>
						</div>
					</div>
				</div>

				{/* Desktop：DBD 式區間框 + AC 式日曆按鈕 */}
				<div
					class="bdcv2-input-cluster bdcv2-input-cluster--desktop"
					aria-label={m.upperControlsAriaLabel}
				>
					<div
						class="bdcv2-date-range-shell bdcv2-date-range-shell--desktop"
						role="group"
						aria-label={m.upperControlsAriaLabel}
					>
						<label class="bdcv2-desktop-field" data-bdcv2-desktop-from-field>
							<span class="sr-only">{m.fromDateLabel}</span>
							<span class="bdcv2-desktop-field-inner">
								<input
									type="text"
									class="bdcv2-date-input"
									data-bdcv2-desktop-from
									inputmode="numeric"
									autocomplete="off"
									spellcheck="false"
									aria-label={m.fromDateInputAriaLabel}
									placeholder={m.dateInputPlaceholder}
								/>
								<span
									class="bdcv2-date-invalid-icon"
									data-bdcv2-desktop-from-invalid
									hidden
									aria-label={invalidDateMessage}
								>
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											fill="currentColor"
											d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
										<path
											fill="#0f172a"
											d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
										></path>
									</svg>
								</span>
							</span>
						</label>
						<span class="bdcv2-date-separator" aria-hidden="true">—</span>
						<label class="bdcv2-desktop-field" data-bdcv2-desktop-to-field>
							<span class="sr-only">{m.toDateLabel}</span>
							<span class="bdcv2-desktop-field-inner">
								<input
									type="text"
									class="bdcv2-date-input"
									data-bdcv2-desktop-to
									inputmode="numeric"
									autocomplete="off"
									spellcheck="false"
									aria-label={m.toDateInputAriaLabel}
									placeholder={m.dateInputPlaceholder}
								/>
								<span
									class="bdcv2-date-invalid-icon"
									data-bdcv2-desktop-to-invalid
									hidden
									aria-label={invalidDateMessage}
								>
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											fill="currentColor"
											d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
										<path
											fill="#0f172a"
											d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
										></path>
									</svg>
								</span>
							</span>
						</label>
						<button
							type="button"
							class="bdcv2-calendar-toggle"
							data-bdcv2-calendar-toggle
							aria-expanded="false"
							aria-controls="bdcv2-calendar-popover"
							aria-label={m.openCalendarAriaLabel}
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								aria-hidden="true"
							>
								<rect x="3" y="5" width="18" height="16" rx="3"></rect>
								<path d="M8 3v4M16 3v4M7 11h10" stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
				</div>

				{/* Mobile：開啟 Bottom Sheet */}
				<div
					class="preview-tool-controls bdcv2-mobile-controls flex flex-wrap justify-center gap-3"
					aria-label={m.upperControlsAriaLabel}
				>
					<button
						type="button"
						class="preview-tool-control-btn bdcv2-mobile-capsule inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 backdrop-blur-sm"
						data-bdcv2-sheet-open
						aria-label={m.openDateSheetAriaLabel}
					>
						<span class="bdcv2-mobile-trigger-icon shrink-0" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<rect x="3" y="5" width="18" height="16" rx="3"></rect>
								<path d="M8 3v4M16 3v4M7 11h10" stroke-linecap="round"></path>
							</svg>
						</span>
						<span data-bdcv2-mobile-range data-bdcv2-empty-label={m.mobileSelectDates}
							>{m.mobileSelectDates}</span
						>
					</button>
				</div>
			</div>
		</div>
	</section>

	{/* B1A：Desktop Related Tools drawer */}
	<aside
		data-bdcv2-drawer
		data-open="true"
		aria-label={m.relatedToolsDrawerAriaLabel}
		class="pointer-events-none fixed inset-y-0 right-0 z-20 hidden xl:block"
	>
		<span class="hidden translate-x-[300px]" aria-hidden="true"></span>
		<div
			data-bdcv2-drawer-shell
			data-open="true"
			class="preview-tool-drawer-frosted pointer-events-auto relative flex h-dvh rounded-tl-3xl rounded-bl-3xl border-l border-white/10 shadow-2xl shadow-black/25 ring-1 ring-inset ring-white/[0.04] transition-transform duration-200 ease-out"
		>
			<button
				type="button"
				data-bdcv2-drawer-toggle
				aria-expanded="true"
				class="relative z-10 flex w-14 shrink-0 items-center justify-center self-stretch text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
				aria-label={m.toggleRelatedToolsDrawerAriaLabel}
			>
				<svg
					data-drawer-arrow-open
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="h-7 w-7"
					aria-hidden="true"
				>
					<path
						d="M10 3L5 8l5 5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				<svg
					data-drawer-arrow-closed
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="hidden h-7 w-7"
					aria-hidden="true"
				>
					<path
						d="M6 3l5 5-5 5"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</button>

			<div
				data-bdcv2-drawer-panel
				class="relative z-10 flex h-full w-[300px] shrink-0 flex-col"
			>
				<div class="px-5 pb-3 pt-5">
					<h2 class="text-lg font-semibold text-white">{messages.relatedTools.heading}</h2>
				</div>
				<ToolAdSlot variant="sidebar" locale={locale} state="is-disabled" />
				<div class="flex-1 space-y-3 overflow-y-auto px-5 pb-5" data-bdcv2-drawer-related-tools>
					{
						relatedToolItems.map((tool) => (
							<div>
								<ToolCard
									href={tool.href}
									name={tool.name}
									description={tool.description}
									icon={tool.icon}
								/>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</aside>

	{/* B1A：下方內容 — Related / About / How to use / Common uses / FAQ + JSON-LD */}
	<div class="tool-lower-content mx-auto max-w-3xl px-6 pb-20 text-left" data-bdcv2-lower-content>
		<ToolAdSlot variant="main" locale={locale} state="is-disabled" />

		<section
			data-bdcv2-related-tools
			class="pb-12 xl:hidden"
			aria-labelledby="bdcv2-related-heading"
		>
			<h2 id="bdcv2-related-heading" class="mb-4 text-lg font-semibold text-white">
				{messages.relatedTools.heading}
			</h2>
			<div class="space-y-3" data-bdcv2-mobile-related-tools>
				{
					relatedToolItems.map((tool) => (
						<RelatedToolRow
							href={tool.href}
							name={tool.name}
							description={tool.description}
							icon={tool.icon}
						/>
					))
				}
			</div>
		</section>

		<section class="pb-12" aria-labelledby="bdcv2-about-heading">
			<h2 id="bdcv2-about-heading" class="mb-2 text-lg font-semibold text-white">
				{m.about.heading}
			</h2>
			<p class="text-sm leading-relaxed text-slate-400">{m.about.body}</p>
		</section>

		<section class="pb-12" aria-labelledby="bdcv2-howto-heading">
			<h2 id="bdcv2-howto-heading" class="mb-2 text-lg font-semibold text-white">
				{m.howTo.heading}
			</h2>
			<ol class="list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-400">
				{m.howTo.steps.map((step) => <li>{step}</li>)}
			</ol>
		</section>

		<section class="pb-12" aria-labelledby="bdcv2-tags-heading">
			<h2 id="bdcv2-tags-heading" class="mb-4 text-lg font-semibold text-white">
				{m.commonUses.heading}
			</h2>
			<ul class="bdcv2-keyword-list" role="list">
				{m.commonUses.items.map((item) => <li class="bdcv2-keyword-chip">{item}</li>)}
			</ul>
		</section>

		<section aria-labelledby="bdcv2-faq-heading">
			<h2 id="bdcv2-faq-heading" class="mb-4 text-lg font-semibold text-white">
				{m.faq.heading}
			</h2>
			<div class="border-t border-white/20">
				{
					m.faq.items.map((item) => (
						<details class="group border-b border-white/20 py-4">
							<summary class="flex list-none items-center justify-between gap-4 font-medium text-white [&::-webkit-details-marker]:hidden">
								<span>{item.question}</span>
								<span class="relative flex h-4 w-4 shrink-0 items-center justify-center text-slate-400">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 16 16"
										fill="none"
										class="h-4 w-4 group-open:hidden"
										aria-hidden="true"
									>
										<path
											d="M8 3.5v9M3.5 8h9"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"></path>
									</svg>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 16 16"
										fill="none"
										class="hidden h-4 w-4 group-open:block"
										aria-hidden="true"
									>
										<path
											d="M3.5 8h9"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"></path>
									</svg>
								</span>
							</summary>
							<p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
						</details>
					))
				}
			</div>
		</section>
	</div>

	{/* Desktop Calendar popover — AC 視覺 + DRC range 行為（B2C） */}
	<div
		id="bdcv2-calendar-popover"
		class="bdcv2-calendar-popover"
		data-bdcv2-calendar-popover
		role="dialog"
		aria-label={m.calendarLabel}
		aria-hidden="true"
		hidden
	>
		<div class="calendar-panel calendar-card bdcv2-calendar-panel">
			<div class="calendar-toolbar">
				<button
					type="button"
					class="calendar-nav-btn"
					data-bdcv2-calendar-prev
					aria-label={m.previousMonth}
				>
					‹
				</button>
				<div class="bdcv2-calendar-selects">
					<div class="bdcv2-calendar-picker" data-bdcv2-month-picker>
						<button
							type="button"
							class="bdcv2-calendar-picker-trigger"
							data-bdcv2-month-trigger
							aria-expanded="false"
							aria-haspopup="listbox"
							aria-controls="bdcv2-calendar-month-panel"
							aria-label={m.monthFieldLabel}
						>
							<span data-bdcv2-month-label>—</span>
						</button>
						<div
							id="bdcv2-calendar-month-panel"
							class="bdcv2-calendar-picker-panel bdcv2-calendar-month-panel"
							data-bdcv2-month-panel
							role="listbox"
							aria-label={m.monthFieldLabel}
							hidden
						>
							<div class="bdcv2-calendar-month-grid" data-bdcv2-month-grid></div>
						</div>
					</div>
					<div class="bdcv2-calendar-picker" data-bdcv2-year-picker>
						<button
							type="button"
							class="bdcv2-calendar-picker-trigger"
							data-bdcv2-year-trigger
							aria-expanded="false"
							aria-haspopup="dialog"
							aria-controls="bdcv2-calendar-year-panel"
							aria-label={m.yearFieldLabel}
						>
							<span data-bdcv2-year-label>—</span>
						</button>
						<div
							id="bdcv2-calendar-year-panel"
							class="bdcv2-calendar-picker-panel bdcv2-calendar-year-panel"
							data-bdcv2-year-panel
							role="dialog"
							aria-label={m.yearFieldLabel}
							hidden
						>
							<input
								type="text"
								class="bdcv2-calendar-year-input"
								data-bdcv2-year-input
								inputmode="numeric"
								autocomplete="off"
								spellcheck="false"
								maxlength="4"
								aria-label={m.yearFieldLabel}
							/>
							<div
								class="bdcv2-calendar-year-list"
								data-bdcv2-year-list
								role="listbox"
								aria-label={m.yearFieldLabel}
							>
							</div>
						</div>
					</div>
				</div>
				<button
					type="button"
					class="calendar-nav-btn"
					data-bdcv2-calendar-next
					aria-label={m.nextMonth}
				>
					›
				</button>
			</div>

			<div class="calendar-weekdays" aria-hidden="true">
				{m.weekdays.map((day) => <span>{day}</span>)}
			</div>

			<div class="calendar-grid" data-bdcv2-calendar-grid></div>
		</div>
	</div>
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

{/* Mobile Sheet — Start／End 各一個 Smart Date Input */}
<div data-bdcv2-sheet-portal data-mobile-sheet-baseline hidden aria-hidden="true">
	<div
		class="tool-operation-overlay"
		data-bdcv2-sheet-overlay
		data-tool-operation-overlay
		hidden
		aria-hidden="true"
	>
	</div>

	<div
		class="msb-sheet bdcv2-sheet"
		data-bdcv2-sheet
		role="dialog"
		aria-modal="true"
		aria-label={m.sheetAriaLabel}
		aria-hidden="true"
		tabindex="-1"
		inert
	>
		<div class="msb-sheet-handle" aria-hidden="true"></div>

		<div class="msb-sheet-body">
			<div class="msb-sheet-fields bdcv2-sheet-fields">
				<label class="msb-field" data-bdcv2-sheet-from-field>
					<span class="msb-input-shell">
						<span class="msb-input-prefix">{m.fromDateLabel}</span>
						<span class="bdcv2-sheet-input-wrap">
							<input
								type="text"
								class="msb-input bdcv2-date-input"
								data-bdcv2-sheet-from
								inputmode="numeric"
								autocomplete="off"
								spellcheck="false"
								aria-label={m.fromDateInputAriaLabel}
								placeholder={m.dateInputPlaceholder}
							/>
							<span
								class="bdcv2-date-invalid-icon"
								data-bdcv2-sheet-from-invalid
								hidden
								aria-label={invalidDateMessage}
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
									<path
										fill="#0f172a"
										d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
									></path>
								</svg>
							</span>
						</span>
					</span>
				</label>

				<label class="msb-field" data-bdcv2-sheet-to-field>
					<span class="msb-input-shell">
						<span class="msb-input-prefix">{m.toDateLabel}</span>
						<span class="bdcv2-sheet-input-wrap">
							<input
								type="text"
								class="msb-input bdcv2-date-input"
								data-bdcv2-sheet-to
								inputmode="numeric"
								autocomplete="off"
								spellcheck="false"
								aria-label={m.toDateInputAriaLabel}
								placeholder={m.dateInputPlaceholder}
							/>
							<span
								class="bdcv2-date-invalid-icon"
								data-bdcv2-sheet-to-invalid
								hidden
								aria-label={invalidDateMessage}
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 1.75 14.25 14.25H1.75L8 1.75z"></path>
									<path
										fill="#0f172a"
										d="M8 5.75a.75.75 0 0 1 .75.75v3.25a.75.75 0 0 1-1.5 0V6.5A.75.75 0 0 1 8 5.75zm0 6.5a.875.875 0 1 1 0 1.75A.875.875 0 0 1 8 12.25z"
									></path>
								</svg>
							</span>
						</span>
					</span>
				</label>
			</div>
		</div>
	</div>
</div>

<script>
	import "../../../scripts/business-days-calculator";
</script>
