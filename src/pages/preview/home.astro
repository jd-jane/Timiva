---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
---

<BaseLayout title="Layout Preview — Home" headerVariant="home">
	<!-- Preview｜首頁 main content（Hero + Featured Tools，以 gap 管理垂直節奏） -->
	<div
		class="mx-auto flex max-w-5xl flex-col gap-12 px-6 py-20 md:gap-16 lg:gap-16"
	>
		<!-- Preview｜首頁 Hero 占位（桌機置中、主標放大、雙 CTA） -->
		<section>
			<div class="text-left md:text-center">
				<div class="space-y-4">
					<p class="text-sm uppercase tracking-[0.2em] text-slate-400">
						Layout Preview
					</p>
					<h1
						class="max-w-4xl text-4xl font-semibold leading-tight tracking-normal md:mx-auto md:text-6xl md:leading-[1.1]"
					>
						Home page hero placeholder
					</h1>
					<p
						class="preview-page-hero-subtitle text-sm leading-relaxed text-slate-300 md:mx-auto md:text-base"
					>
						This page is for checking BaseLayout spacing, global background glow, Header
						home variant, and Footer. Not a final homepage design.
					</p>
				</div>
				<div class="mt-8 hidden items-center justify-center gap-4 lg:flex">
				<a
					href="#"
					class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/10 px-8 py-3 text-base font-medium text-slate-300 transition-colors hover:border-white/20 hover:text-white"
				>
					View featured
				</a>
				<a
					href="#"
					class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/15 bg-white/5 px-8 py-3 text-base font-medium text-white backdrop-blur-sm transition-colors hover:bg-white/10"
				>
					Browse tools
				</a>
				</div>
			</div>
		</section>

		<!-- Preview｜Featured Tools 工具卡片（桌機 4 欄、平板 2 欄、手機 2×2） -->
		<section class="flex flex-col gap-8">
			<div class="grid grid-cols-2 items-stretch gap-4 md:gap-5 lg:grid-cols-4">
				<ToolCard
					name="Event Countdown"
					description="Count down to dates that matter."
					icon="calendar"
				/>
				<ToolCard
					name="Date Range Calculator"
					description="Calculate days between two dates."
					icon="plus-square"
				/>
				<ToolCard
					name="Age Calculator"
					description="Find exact age from a birthday."
					icon="person"
				/>
				<ToolCard
					name="Life Progress Bar"
					description="See time progress at a glance."
					icon="progress"
				/>
			</div>
			<div class="flex justify-start md:justify-center">
			<a
				href="#"
				class="inline-flex items-center gap-2 text-sm text-slate-400 transition-colors hover:text-white"
			>
				View all tools
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 16 16"
					fill="none"
					class="h-4 w-4"
					aria-hidden="true"
				>
					<path
						d="M3 8h8M9 5l3 3-3 3"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
			</div>
		</section>
	</div>
</BaseLayout>
