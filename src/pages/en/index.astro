---
import "../../styles/pages/home-entrance.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdContainerReserved from "../../components/home/AdContainerReserved.astro";
import HomeFaqSection from "../../components/home/HomeFaqSection.astro";
import HomeHeroChips from "../../components/home/HomeHeroChips.astro";
import ToolCard from "../../components/ToolCard.astro";
import { featuredTools, type FeaturedToolId } from "../../data/homeTools";
import { buildHomePageJsonLd } from "../../lib/buildHomePageJsonLd";
import { homeFeaturedIconMap } from "../../lib/homeFeaturedIcons";
import { getPageRouteMeta } from "../../lib/pageRouteMeta";
import { getLocalizedPath, routePaths, siteUrl, type Locale } from "../../i18n/config";
import { getMessages } from "../../i18n/messages";

const locale: Locale = "en";
const messages = getMessages(locale);
const routeMeta = getPageRouteMeta(routePaths.home, locale);
const homeUrl = `${siteUrl}${getLocalizedPath(locale, routePaths.home)}`;

const toolCopy: Record<
	FeaturedToolId,
	{
		title: string;
		description: string;
	}
> = messages.home.featuredTools;

function toolHref(slug: string, available: boolean): string {
	if (!available) {
		return "#";
	}

	return getLocalizedPath(locale, `/${slug}/`);
}

const jsonLdSchemas = buildHomePageJsonLd({
	locale,
	homeUrl,
	tools: featuredTools.map((tool) => ({
		id: tool.id,
		slug: tool.slug,
		name: toolCopy[tool.id].title,
	})),
	faqItems: messages.home.faq.items,
});

const heroTitleEndDotClass =
	"ml-[0.06em] inline-block h-[0.12em] w-[0.12em] translate-y-[0.1em] rounded-full bg-[#F04438]";
const heroTitleMidDotClass =
	"ml-[0.06em] mr-[0.2em] inline-block h-[0.12em] w-[0.12em] translate-y-[0.1em] rounded-full bg-[#F04438]";
const [heroTitleFirst, heroTitleSecond, heroTitleThird] = messages.home.heroTitle
	.split(",")
	.map((part) => part.trim());
---

<BaseLayout
	title={messages.meta.home.title}
	description={messages.meta.home.description}
	canonicalUrl={routeMeta.canonicalUrl}
	alternateUrls={routeMeta.alternateUrls}
	headerVariant="home"
	locale={locale}
>
	<div class="relative isolate">
		<div
			class="relative z-10 mx-auto flex max-w-5xl flex-col gap-12 px-6 py-12 md:gap-16 md:py-20 lg:gap-16"
		>
			<section class="home-hero">
				<div class="text-left md:text-center">
					<div class="space-y-4">
						<h1
							class="home-entrance-title max-w-4xl text-4xl font-semibold leading-tight tracking-normal md:mx-auto md:text-6xl md:leading-[1.1]"
							aria-label={`${messages.home.heroTitle}.`}
						>
							{heroTitleFirst}<span aria-hidden="true" class={heroTitleMidDotClass}></span>{heroTitleSecond}<span aria-hidden="true" class={heroTitleMidDotClass}></span>{heroTitleThird}<span aria-hidden="true" class={heroTitleEndDotClass}></span>
						</h1>
						<p
							class="home-entrance-subtitle preview-page-hero-subtitle text-sm leading-relaxed text-slate-300 md:mx-auto md:text-base"
						>
							{messages.home.heroLead}
						</p>
					</div>
					<HomeHeroChips
						chips={messages.home.chips}
						groupAriaLabel={messages.home.chipsGroupAriaLabel}
					/>
				</div>
			</section>

			<section class="flex flex-col gap-8">
				<div class="grid grid-cols-2 items-stretch gap-4 md:gap-5 lg:grid-cols-4">
					{
						featuredTools.map((tool) => (
							<div class="home-entrance-card">
								<ToolCard
									href={toolHref(tool.slug, tool.available)}
									name={toolCopy[tool.id].title}
									description={toolCopy[tool.id].description}
									icon={homeFeaturedIconMap[tool.id]}
								/>
							</div>
						))
					}
				</div>
				<div class="home-entrance-view-all flex justify-start md:justify-center">
					<a
						href={getLocalizedPath(locale, routePaths.allTools)}
						class="inline-flex items-center gap-2 text-sm text-slate-400 transition-colors hover:text-white"
					>
						{messages.home.viewAllTools}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 16 16"
							fill="none"
							class="h-4 w-4"
							aria-hidden="true"
						>
							<path
								d="M3 8h8M9 5l3 3-3 3"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</a>
				</div>
			</section>

			<AdContainerReserved state="is-disabled" />

			<div class="home-entrance-faq">
				<HomeFaqSection heading={messages.home.faq.heading} items={messages.home.faq.items} />
			</div>
		</div>
	</div>

	{
		jsonLdSchemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))
	}
</BaseLayout>
