---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InnerPageShell from "../../../components/InnerPageShell.astro";
import ToolCard from "../../../components/ToolCard.astro";
import { catalogIconMap } from "../../../lib/catalogIcons";
import {
	getAvailableToolsGroupedByCategory,
	type CatalogToolId,
	type ToolCategoryId,
} from "../../../data/toolsCatalog";
import { getPageRouteMeta } from "../../../lib/pageRouteMeta";
import { getLocalizedPath, routePaths, type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

const locale: Locale = "en";
const messages = getMessages(locale);
const routeMeta = getPageRouteMeta(routePaths.allTools, locale);
const groupedTools = getAvailableToolsGroupedByCategory();

const categoryLabels: Record<ToolCategoryId, string> = {
	"dates-events": messages.allTools.categories.datesEvents,
	productivity: messages.allTools.categories.productivity,
	"body-flow": messages.allTools.categories.bodyFlow,
	momentum: messages.allTools.categories.momentum,
};

const toolCopy: Record<
	CatalogToolId,
	{
		title: string;
		description: string;
	}
> = {
	"event-countdown": messages.tools.eventCountdown,
	"date-range": messages.tools.dateRange,
	"countdown-timer": messages.tools.countdownTimer,
	"year-progress": messages.tools.yearProgress,
	"age-calculator": messages.tools.ageCalculator,
	"days-between-dates": messages.tools.daysBetweenDates,
	"business-days-calculator": messages.tools.businessDaysCalculator,
	"life-progress": messages.tools.lifeProgress,
	"date-calculator": messages.tools.dateCalculator,
};
---

<BaseLayout
	title={messages.meta.allTools.title}
	description={messages.meta.allTools.description}
	canonicalUrl={routeMeta.canonicalUrl}
	alternateUrls={routeMeta.alternateUrls}
	headerVariant="inner"
	locale={locale}
>
	<InnerPageShell>
		<section>
			<div class="text-left md:text-center">
				<div class="space-y-4">
					<h1 class="text-3xl font-semibold tracking-normal md:text-4xl">
						{messages.allTools.heading}
					</h1>
					<p
						class="preview-page-hero-subtitle text-sm leading-relaxed text-slate-400 md:mx-auto md:text-base"
					>
						{messages.allTools.lead}
					</p>
				</div>
			</div>
		</section>

		{
			groupedTools.map(({ categoryId, tools }) => (
				<section class="flex flex-col gap-5">
					<h2 class="text-left text-lg font-semibold text-white">
						{categoryLabels[categoryId]}
					</h2>
					<div class="grid grid-cols-2 items-stretch gap-4 md:gap-5">
						{tools.map((tool) => (
							<ToolCard
								href={getLocalizedPath(locale, `/${tool.slug}/`)}
								name={toolCopy[tool.id].title}
								description={toolCopy[tool.id].description}
								icon={catalogIconMap[tool.id]}
							/>
						))}
					</div>
				</section>
			))
		}
	</InnerPageShell>
</BaseLayout>
