---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LegalTextLayout from "../../../components/LegalTextLayout.astro";
import { getPageRouteMeta } from "../../../lib/pageRouteMeta";
import { routePaths, type Locale } from "../../../i18n/config";
import { Content, frontmatter } from "../../../content/legal/en/terms.md";

const locale: Locale = "en";
const pageTitle = `${frontmatter.title} | Timiva`;
const routeMeta = getPageRouteMeta(routePaths.terms, locale);
const [, updatedYear, updatedMonth] =
	frontmatter.lastUpdated.match(/^(\d{4})-(\d{2})$/) ?? [];
const metaLine =
	updatedYear && updatedMonth
		? `Last updated: ${new Date(Number(updatedYear), Number(updatedMonth) - 1, 1).toLocaleDateString("en", { month: "long", year: "numeric" })}`
		: undefined;
---

<BaseLayout
	title={pageTitle}
	description={frontmatter.description}
	canonicalUrl={routeMeta.canonicalUrl}
	alternateUrls={routeMeta.alternateUrls}
	headerVariant="inner"
	locale={locale}
>
	<LegalTextLayout locale={locale} heading={frontmatter.title} metaLine={metaLine}>
		<Content />
	</LegalTextLayout>
</BaseLayout>
