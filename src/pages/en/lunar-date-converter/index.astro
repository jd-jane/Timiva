---
import "../../../styles/tools/timiva-tokens.css";
import "../../../styles/tools/tool-design-system.css";
import "../../../styles/tools/tool-result-v2-baseline.css";
import "../../../styles/tools/tool-overlay-v2-baseline.css";
import "../../../styles/tools/tool-drawer-v2-baseline.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LunarDateConverterV2 from "../../../components/tools/lunar-date-converter-v2/LunarDateConverterV2.astro";
import { getLunarDateConverterRouteMeta } from "../../../lib/lunarDateConverterRouteMeta";
import { type Locale } from "../../../i18n/config";

const locale: Locale = "en";
const routeMeta = getLunarDateConverterRouteMeta(locale);
---

<BaseLayout
	title={routeMeta.title}
	description={routeMeta.description}
	canonicalUrl={routeMeta.canonicalUrl}
	alternateUrls={routeMeta.alternateUrls}
	headerVariant="inner"
	locale={locale}
>
	<LunarDateConverterV2 locale={locale} />
</BaseLayout>
