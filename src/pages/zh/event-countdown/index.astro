---
// 中文版 Event Countdown 正式頁｜V2 production entry
import "../../../styles/tools/tool-result-v2-baseline.css";
import "../../../styles/tools/tool-overlay-v2-baseline.css";
import "../../../styles/tools/event-countdown-v2.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EventCountdownV2 from "../../../components/tools/event-countdown-v2/EventCountdownV2.astro";
import { getEventCountdownRouteMeta } from "../../../lib/eventCountdownRouteMeta";
import { type Locale } from "../../../i18n/config";

const locale: Locale = "zh";
const routeMeta = getEventCountdownRouteMeta(locale);
---

<BaseLayout
	title={routeMeta.title}
	description={routeMeta.description}
	canonicalUrl={routeMeta.canonicalUrl}
	alternateUrls={routeMeta.alternateUrls}
	headerVariant="inner"
	locale={locale}
>
	<EventCountdownV2 locale={locale} mode="production" />
	<script src="/scripts/countdown-v2.js" defer></script>
</BaseLayout>
