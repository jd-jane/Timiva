---
import "../../../styles/tools/timiva-tokens.css";
import "../../../styles/tools/tool-design-system.css";
import "../../../styles/tools/tool-result-v2-baseline.css";
import "../../../styles/tools/tool-overlay-v2-baseline.css";
import "../../../styles/tools/tool-drawer-v2-baseline.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BusinessDaysCalculatorV2 from "../../../components/tools/business-days-calculator-v2/BusinessDaysCalculatorV2.astro";
import { getBusinessDaysCalculatorRouteMeta } from "../../../lib/businessDaysCalculatorRouteMeta";
import { type Locale } from "../../../i18n/config";

const locale: Locale = "zh";
const routeMeta = getBusinessDaysCalculatorRouteMeta(locale);
---

<BaseLayout
	title={routeMeta.title}
	description={routeMeta.description}
	canonicalUrl={routeMeta.canonicalUrl}
	alternateUrls={routeMeta.alternateUrls}
	headerVariant="inner"
	locale={locale}
>
	<BusinessDaysCalculatorV2 locale={locale} />
</BaseLayout>
