---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LegalTextLayout from "../../../components/LegalTextLayout.astro";
import { type Locale } from "../../../i18n/config";
import { Content, frontmatter } from "../../../content/legal/zh/contact.md";

const locale: Locale = "zh";
const pageTitle = `${frontmatter.title} | Timiva`;
const [, updatedYear, updatedMonth] =
	frontmatter.lastUpdated.match(/^(\d{4})-(\d{2})$/) ?? [];
const metaLine =
	updatedYear && updatedMonth
		? `最後更新：${updatedYear} 年 ${Number(updatedMonth)} 月`
		: undefined;
---

<BaseLayout
	title={pageTitle}
	description={frontmatter.description}
	headerVariant="inner"
	locale={locale}
>
	<LegalTextLayout locale={locale} heading={frontmatter.title} metaLine={metaLine}>
		<Content />
	</LegalTextLayout>
</BaseLayout>
