---
import "../../../styles/tools/timiva-tokens.css";
import "../../../styles/tools/tool-design-system.css";
import "../../../styles/tools/tool-result-v2-baseline.css";
import "../../../styles/tools/tool-overlay-v2-baseline.css";
import "../../../styles/tools/date-range.css";
import "../../../styles/tools/date-range-calculator-v2.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DateRangeCalculatorV2 from "../../../components/tools/date-range-calculator-v2/DateRangeCalculatorV2.astro";
import { type Locale } from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";

const locale: Locale = "zh";
const messages = getMessages(locale);
---

<BaseLayout
	title={messages.meta.dateRangeCalculator.title}
	description={messages.meta.dateRangeCalculator.description}
	headerVariant="inner"
	locale={locale}
>
	<DateRangeCalculatorV2 locale={locale} />
</BaseLayout>
