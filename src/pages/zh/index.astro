---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
import { featuredTools, type FeaturedToolId } from "../../data/homeTools";
import { catalogIconMap } from "../../lib/catalogIcons";
import { getLocalizedPath, routePaths, type Locale } from "../../i18n/config";
import { getMessages } from "../../i18n/messages";

const locale: Locale = "zh";
const messages = getMessages(locale);

const toolCopy: Record<
	FeaturedToolId,
	{
		title: string;
		description: string;
	}
> = {
	"event-countdown": messages.tools.eventCountdown,
	"date-range": messages.tools.dateRange,
	"age-calculator": messages.tools.ageCalculator,
	"life-progress": messages.tools.lifeProgress,
};

function toolHref(slug: string, available: boolean): string {
	if (!available) {
		return "#";
	}

	return getLocalizedPath(locale, `/${slug}/`);
}

const heroTitleDotClass =
	"ml-[0.1em] inline-block h-[0.12em] w-[0.12em] translate-y-[0.1em] rounded-full bg-[#F04438]";
const heroTitleMidDotClass =
	"ml-[0.1em] mr-[0.16em] inline-block h-[0.12em] w-[0.12em] translate-y-[0.1em] rounded-full bg-[#F04438]";
const [heroTitleBefore, heroTitleAfter] = messages.home.heroTitle.split("，");
---

<BaseLayout
	title={messages.meta.home.title}
	description={messages.meta.home.description}
	headerVariant="home"
	locale={locale}
>
	<div
		class="mx-auto flex max-w-5xl flex-col gap-12 px-6 py-20 md:gap-16 lg:gap-16"
	>
		<section>
			<div class="text-left md:text-center">
				<div class="space-y-4">
					<h1
						class="max-w-4xl text-4xl font-semibold leading-tight tracking-normal md:mx-auto md:text-6xl md:leading-[1.1]"
						aria-label={`${messages.home.heroTitle}。`}
					>
						{heroTitleBefore}<span aria-hidden="true" class={heroTitleMidDotClass}></span><br
							class="zh-hero-mobile-break"
						/>{heroTitleAfter}<span aria-hidden="true" class={heroTitleDotClass}></span>
					</h1>
					<p
						class="preview-page-hero-subtitle text-sm leading-relaxed text-slate-300 md:mx-auto md:text-base"
					>
						{messages.home.heroLead}
					</p>
				</div>
				<div class="mt-8 hidden items-center justify-center gap-4 lg:flex">
					<a
						href={getLocalizedPath(locale, routePaths.eventCountdown)}
						class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/10 px-8 py-3 text-base font-medium text-slate-300 transition-colors hover:border-white/20 hover:text-white"
					>
						{messages.home.ctaPrimary}
					</a>
					<a
						href={getLocalizedPath(locale, routePaths.dateRangeCalculator)}
						class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/15 bg-white/5 px-8 py-3 text-base font-medium text-white backdrop-blur-sm transition-colors hover:bg-white/10"
					>
						{messages.home.ctaSecondary}
					</a>
				</div>
			</div>
		</section>

		<section class="flex flex-col gap-8">
			<div class="grid grid-cols-2 items-stretch gap-4 md:gap-5 lg:grid-cols-4">
				{
					featuredTools.map((tool) => (
						<ToolCard
							href={toolHref(tool.slug, tool.available)}
							name={toolCopy[tool.id].title}
							description={toolCopy[tool.id].description}
							icon={catalogIconMap[tool.id]}
						/>
					))
				}
			</div>
			<div class="flex justify-start md:justify-center">
				<a
					href={getLocalizedPath(locale, routePaths.allTools)}
					class="inline-flex items-center gap-2 text-sm text-slate-400 transition-colors hover:text-white"
				>
					{messages.home.viewAllTools}
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 16 16"
						fill="none"
						class="h-4 w-4"
						aria-hidden="true"
					>
						<path
							d="M3 8h8M9 5l3 3-3 3"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</a>
			</div>
		</section>
	</div>
</BaseLayout>
