---
// Root locale redirect — reads preferredLocale from localStorage only on `/`.
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Timiva</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href="https://timiva.app/en/" />
	</head>
	<body>
		<script is:inline>
			(function () {
				var locale = "en";

				try {
					var stored = localStorage.getItem("preferredLocale");
					if (stored === "zh" || stored === "en") {
						locale = stored;
					}
				} catch (e) {}

				window.location.replace("/" + locale + "/");
			})();
		</script>
		<noscript>
			<p><a href="/en/">Continue to Timiva</a></p>
		</noscript>
	</body>
</html>
