---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import { analyticsEnabled, gaMeasurementId } from "../lib/analyticsConfig";
import { siteUrl, type Locale } from "../i18n/config";

interface Props {
	title?: string;
	description?: string;
	robots?: string;
	canonicalUrl?: string;
	alternateUrls?: Partial<Record<Locale, string>>;
	headerVariant?: "home" | "inner";
	locale?: Locale;
}

const {
	title = "Timiva",
	description,
	robots,
	canonicalUrl,
	alternateUrls,
	headerVariant = "home",
	locale = "en",
} = Astro.props;

const htmlLang = locale === "zh" ? "zh-Hant" : "en";

function toAbsoluteUrl(path: string) {
	if (path.startsWith("http://") || path.startsWith("https://")) {
		return path;
	}

	return `${siteUrl}${path.startsWith("/") ? path : `/${path}`}`;
}
---

<!doctype html>
<html lang={htmlLang} data-ga-measurement-id={analyticsEnabled ? gaMeasurementId : undefined}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		{robots && <meta name="robots" content={robots} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{
			alternateUrls?.en && (
				<link rel="alternate" hreflang="en" href={toAbsoluteUrl(alternateUrls.en)} />
			)
		}
		{
			alternateUrls?.zh && (
				<link
					rel="alternate"
					hreflang="zh-Hant"
					href={toAbsoluteUrl(alternateUrls.zh)}
				/>
			)
		}
		{
			alternateUrls?.en && (
				<link
					rel="alternate"
					hreflang="x-default"
					href={toAbsoluteUrl(alternateUrls.en)}
				/>
			)
		}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-slate-950 text-white antialiased">
		<!-- Layout｜全站基礎骨架 -->
		<div class="relative isolate min-h-screen">
			<!-- Background｜全站背景層 -->
			<div
				aria-hidden="true"
				class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
			>
				<div class="absolute inset-0 bg-slate-950"></div>
				<div
					class="absolute left-1/2 top-[-18%] h-[58vh] w-[92vw] max-w-none -translate-x-1/2 rounded-full bg-indigo-400/20 blur-[120px]"
				>
				</div>
				<div
					class="absolute -right-[10%] top-[-8%] h-[42vh] w-[55vw] rounded-full bg-violet-400/15 blur-[120px]"
				>
				</div>
				<div
					class="absolute -left-[8%] bottom-[18%] h-[36vh] w-[48vw] rounded-full bg-blue-600/10 blur-[120px]"
				>
				</div>
				<div
					class="absolute inset-0 bg-gradient-to-b from-slate-950/20 via-slate-950/80 to-slate-950"
				>
				</div>
				<div
					class="absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-slate-950 via-slate-950/95 to-transparent"
				>
				</div>
			</div>

			<Header variant={headerVariant} locale={locale} />

			<!-- Main｜頁面主要內容 -->
			<main class="site-main">
				<slot />
			</main>

			<Footer locale={locale} analyticsEnabled={analyticsEnabled} />
		</div>

		{analyticsEnabled && <script is:inline src="/scripts/analytics-consent.js"></script>}
		{analyticsEnabled && <AnalyticsConsent locale={locale} />}
	</body>
</html>
